#!/bin/bash
# author: laryakan, date 2021/03/12
# Per-server VSS env file; values between these markers are exported.
set -o allexport
# DEBUG MODE ?
DEBUGMODE=0

# Shared server/log directories and VSS tooling are configured in the root .env.
VALHEIMSERVERLOGPATH=''

### STATUS ###
# Optional PID override. Otherwise VSS identifies the process by world name.
VALSERVERPID=''
# Valheim server version
VALSERVERVERSION="0.0.0"
# Valheim server last update
VALSERVERLASTUPDATE="0"
# VSS state files are fixed under "$VSSDIR/data" by lib/config.sh.

### STATUS OVER HTTP ###
# Status URL
STATUSURL=''
# Port listening for ncat valheim server status over HTTP in real time
STATUSPORT=8181

### DISCORD WEBHOOK ###
# The webhook credentials and send options are shared in the root .env.
# At first launch, the webhook will create a new message. If you want the webhook to update your message
# instead of creating new ones, paste the message id here. CAUTION: The webhook and only update its own messages
STATUSMESSAGEID=''
# Log message ID for this profile once posted by the shared webhook
LASTLOGMESSAGEID=''
# Connection-info message ID for this profile
SERVERCONNECTIONINFOMESSAGEID=''

### Valheim server log sniffer through *custom launcher* ###
# Valheim server port
VHSERVERPORT=2456
# Your server name
VHSERVERNAME='server.name'
# If you already have a server running, please provide your current infos, or the server will change name
VHSERVERWORLD='server.world'
# Informational world seed displayed in status/Discord; VSS cannot set or change the server's seed
VHSERVERSEED='SuperSeed'
# Crossplay switch: 1=enabled, 0=disabled
VHSERVERCROSSPLAY=0
# Your server password
VHSERVERPASSWD='server.password'

### SERVICES ###
VHSERVERLAUNCHERARGS="$VSSDIR/launcher/launcher-args.$VSS_SERVER_NAME"
# Valheim server service name
VHSERVERSERVICENAME="valheim-server.$VSS_SERVER_NAME.service"
# vss over HTTP service name
VSSHTTPSERVICENAME="vss.http.$VSS_SERVER_NAME.service"
# Tail pipe on Valheim server logs service name
VSSPIPESERVICENAME="vss.pipe.$VSS_SERVER_NAME.service"

# BepInEx
BEPINEXVERSION="0.0.0"
BEPINEXLASTUPDATE="0"
VSSBEPINEXENABLED=0
VSSBEPINEXDIR="$VSSDIR/bepinex/profiles/$VSS_SERVER_NAME"
VSSBEPINEXLOGOUTPUT="$VSSBEPINEXDIR/BepInEx/LogOutput.log"
# Internal setup state: whether a log pipe service existed before BepInEx enabled it
VSSPIPEPREEXISTING=''
# Optional R2Modman/Thunderstore profile code shown in Discord and server status when BepInEx is enabled
R2MODMANCODE=''

set +o allexport
#EOF
