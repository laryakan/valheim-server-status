#!/bin/bash
# author: laryakan, date 2021/03/12
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/../crash.log"
source "$CWD/../.env"
VSSDIR="${VSSDIR:-$CWD}"
LIBDIR="${LIBDIR:-$VSSDIR/lib}"

source "$LIBDIR/server-status-common.sh"
source "$LIBDIR/server-status-process.sh"
source "$LIBDIR/server-status-ingame-time.sh"
source "$LIBDIR/server-status-game-version.sh"
source "$LIBDIR/server-status-bepinex.sh"
server_status_collect_process_stats
server_status_calculate_ingame_clock
server_status_prepare_weather
server_status_prepare_game_version
server_status_prepare_bepinex
CURRENT_START_TS="${PROCESS_START_TS:-unknown}"
if [ "$CURRENT_START_TS" = "unknown" ]; then
	CURRENT_START_TS="${VALSERVERLASTSTART:-unknown}"
fi
LAST_WORLD_SAVE_TS="$(cat "$LASTWORLDSAVEFILE" 2>/dev/null || echo "unknown")"
CURRENT_SEED="${VHSERVERSEED:-unknown}"
CURRENT_WORLD="${VHSERVERWORLD:-unknown}"

if [ "$1" = '--for-webhook' ]
then
	if [ -z "$VALHEIM_PID" ]
	then
		echo -n "{\"title\":\"$(T server_status_title)\",
		\"embeds\":[{\"title\":\"$(T offline)\",\"color\":15158332,
		\"fields\":[
		{\"name\":\"$(T version)\",\"value\": \"${VERSION_LABEL}\",\"inline\":true},
		{\"name\":\"$(T last_start)\",\"value\": \"${CURRENT_START_TS}\",\"inline\":true},
		{\"name\":\"$(T last_save)\",\"value\": \"${LAST_WORLD_SAVE_TS}\",\"inline\":true},
		{\"name\":\"$(T last_check)\",\"value\": \"$(date +'%F.%T')\"}
		]}
		]}"
		exit 0
	else
		LIGHTONLINELIST=$(touch "$CONNECTEDPLAYERSFILE" && awk -F';' 'NF >= 3 && $2 != "" { print $2 }' "$CONNECTEDPLAYERSFILE" | paste -sd, - | sed 's/,/, /g')
		LIGHTOFFLINELIST=$(touch "$OFFLINEPLAYERSFILE" && awk -F';' 'NF >= 3 && $2 != "" { print $2 }' "$OFFLINEPLAYERSFILE" | paste -sd, - | sed 's/,/, /g')
		LIGHTONLINELIST=${LIGHTONLINELIST:-nobody}
		LIGHTOFFLINELIST=${LIGHTOFFLINELIST:-nobody}
		VSSCURRENTMODIFIER=$(cat $CWD/../launcher/launcher-args)
		echo -n "{\"title\":\"$(T server_status_title)\",
		\"embeds\":[{\"title\":\"$(T online)\",\"color\":3066993,
		\"fields\":[
		{\"name\":\"$(T cpu)\",\"value\": \"${CPUUSAGE}%\",\"inline\":true},
		{\"name\":\"$(T ram)\",\"value\": \"${RAMUSAGE}%\",\"inline\":true},
		{\"name\":\"$(T version)\",\"value\": \"${VERSION_LABEL}\",\"inline\":true},
		{\"name\":\"BepInEx\",\"value\": \"${BEPINEXVERSION_LABEL}\",\"inline\":true},
		{\"name\":\"$(T last_start)\",\"value\": \"${CURRENT_START_TS}\",\"inline\":true},
		{\"name\":\"$(T last_save)\",\"value\": \"${LAST_WORLD_SAVE_TS}\",\"inline\":true},
		{\"name\":\"seed\",\"value\": \"||${CURRENT_SEED}||\",\"inline\":true},
		{\"name\":\"$(T current_day)\",\"value\": \"${CURRENT_INGAMEDAYNUMBER}\",\"inline\":true},
		{\"name\":\"$(T current_time)\",\"value\": \"${INGAME_TIME_LABEL}\",\"inline\":true},
		{\"name\":\"$(T weather_forecast)\",\"value\": \"${WEATHERFORECAST_VALUE}\",\"inline\":false},
		{\"name\":\"$(T online)\",\"value\": \"${LIGHTONLINELIST}\",\"inline\":true},
		{\"name\":\"$(T offline)\",\"value\": \"${LIGHTOFFLINELIST}\",\"inline\":true},
		{\"name\":\"$(T last_check)\",\"value\": \"$(date +'%F.%T')\"}
		]}
		]}"
	fi
	exit 0
fi

echo -e ">=VALHEIM SERVER STATUS @ `date +'%F.%T'`=<"
if [ -z "$VALHEIM_PID" ]
then
       echo -e "SERVER OFFLINE !"
       echo -e "\n**Server version**"
       echo -e "${CURRENT_VERSION} (${CURRENT_VERSION_TS})"
       echo -e "\n**$(T last_start)**"
       echo -e "${CURRENT_START_TS}"
       echo -e "\n**$(T last_save)**"
       echo -e "${LAST_WORLD_SAVE_TS}"
       echo -e "\n**Server seed**"
       echo -e "${CURRENT_SEED}"
       exit 1
else
       echo -e "SERVER ONLINE !"
fi

echo -e "\n**Server session running since**"
ps -p "$VALHEIM_PID" -o lstart,etime

echo -e "\n**Server version**"
echo -e "${CURRENT_VERSION} (${CURRENT_VERSION_TS})"
echo -e "\n**$(T last_start)**"
echo -e "${CURRENT_START_TS}"
echo -e "\n**$(T last_save)**"
echo -e "${LAST_WORLD_SAVE_TS}"
echo -e "\n**Server seed**"
echo -e "${CURRENT_SEED}"
echo -e "\n**$(T current_day)**"
echo -e "${CURRENT_INGAMEDAYNUMBER}"
echo -e "\n**$(T current_time)**"
echo -e "${INGAME_TIME_LABEL}"

echo -e "\n**Server consumption**"
echo -e "CPU ($TOTALCPU cores) : $CPUUSAGE%"
echo -e "RAM ($TOTALRAM MB) : $RAMUSAGE%"

echo -e "\n**Connected players**"
cat "$CONNECTEDPLAYERSFILE"

echo -e "\n**Offline players**"
cat "$OFFLINEPLAYERSFILE"
