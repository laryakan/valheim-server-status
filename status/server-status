#!/bin/bash
# author: laryakan, date 2021/03/12
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/../crash.log"
source "$CWD/../.env"

# Stats
TOTALCPU=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
TOTALCPU=$(( TOTALCPU > 0 ? TOTALCPU : 1 ))
TOTALRAM=$(( $(grep MemTotal /proc/meminfo 2>/dev/null | cut -d' ' -f9 || echo 0) / 1024 ))

VALHEIM_PID="${VALSERVERPID:-}"
if [ -n "$VALHEIM_PID" ] && ps -p "$VALHEIM_PID" >/dev/null 2>&1
then
	:
else
	VALHEIM_PID=$(pgrep -f 'valheim_server' 2>/dev/null | head -n 1)
fi

if [ -n "$VALHEIM_PID" ]
then
	PS_OUTPUT=$(LC_ALL=C ps -p "$VALHEIM_PID" -o lstart=,%cpu=,%mem= --no-headers 2>/dev/null | head -n 1)
	if [ -n "$PS_OUTPUT" ]
	then
		read -r START_DAY START_MONTH START_DAYNUM START_TIME START_YEAR CPUUSAGE_RAW RAMUSAGE_RAW <<EOF
$PS_OUTPUT
EOF
		PROCESS_START_RAW="${START_DAY} ${START_MONTH} ${START_DAYNUM} ${START_TIME} ${START_YEAR}"
		PROCESS_START_TS=$(date -d "$PROCESS_START_RAW" '+%d/%m/%Y %H:%M:%S' 2>/dev/null || true)
		CPUUSAGE=$(printf '%s' "$CPUUSAGE_RAW" | tr ',' '.' | awk '{printf "%.0f", $1}')
		RAMUSAGE=$(printf '%s' "$RAMUSAGE_RAW" | tr ',' '.' | awk '{printf "%.0f", $1}')
	else
		PROCESS_START_TS="unknown"
		CPUUSAGE=0
		RAMUSAGE=0
	fi
	if [ "$TOTALCPU" -gt 0 ]
	then
		CPUUSAGE=$(( CPUUSAGE / TOTALCPU ))
	fi
else
	PROCESS_START_TS="unknown"
	CPUUSAGE=0
	RAMUSAGE=0
fi

source "$CWD/../i18n.sh"

CURRENT_VERSION="${VALSERVERVERSION:-unknown}"
CURRENT_VERSION_TS="${VALSERVERLASTUPDATE:-unknown}"
CURRENT_START_TS="${VALSERVERLASTSTART:-unknown}"
LAST_WORLD_SAVE_TS="$(cat "$CWD/../last-world-save" 2>/dev/null || echo "unknown")"
if [ -n "$PROCESS_START_TS" ] && [ "$PROCESS_START_TS" != "unknown" ]; then
	CURRENT_START_TS="$PROCESS_START_TS"
fi
if [ -z "$CURRENT_START_TS" ] || [ "$CURRENT_START_TS" = "0" ] || [ "$CURRENT_START_TS" = "unknown" ]; then
	CURRENT_START_TS="unknown"
fi
CURRENT_SEED="${VHSERVERSEED:-unknown}"
CURRENT_WORLD="${VHSERVERWORLD:-unknown}"
VERSION_LABEL="${CURRENT_VERSION} (${CURRENT_VERSION_TS})"

if [ "$1" = '--for-webhook' ]
then
	if [ -z "$VALHEIM_PID" ]
	then
		echo -n "{"embeds":[{"title":"$(T offline)","color":15158332,"url":"$STATUSURL/","fields":[{"name":"$(T last_check)","value": "$(date +'%F.%T')"},{"name":"$(T version)","value": "${VERSION_LABEL}","inline":true},{"name":"$(T last_start)","value": "${CURRENT_START_TS}","inline":true},{"name":"$(T last_save)","value": "${LAST_WORLD_SAVE_TS}","inline":true},{"name":"seed","value": "${CURRENT_SEED}","inline":true},{"name":"world","value": "${CURRENT_WORLD}","inline":true}}]}"
		exit 1
	else
		LIGHTONLINELIST=$(touch "$CONNECTEDPLAYERSFILE" && awk -F';' 'NF >= 3 && $2 != "" { print $2 }' "$CONNECTEDPLAYERSFILE" | paste -sd, - | sed 's/,/, /g')
		LIGHTOFFLINELIST=$(touch "$OFFLINEPLAYERSFILE" && awk -F';' 'NF >= 3 && $2 != "" { print $2 }' "$OFFLINEPLAYERSFILE" | paste -sd, - | sed 's/,/, /g')
		LIGHTONLINELIST=${LIGHTONLINELIST:-nobody}
		LIGHTOFFLINELIST=${LIGHTOFFLINELIST:-nobody}
		echo -n "{"title":"$(T server_status_title)","embeds":[{"title":"$(T online)","color":3066993,"url":"$STATUSURL","fields":[{"name":"$(T cpu)","value": "$CPUUSAGE%","inline":true},{"name":"$(T ram)","value": "$RAMUSAGE%","inline":true},{"name":"$(T version)","value": "${VERSION_LABEL}","inline":true},{"name":"$(T last_start)","value": "${CURRENT_START_TS}","inline":true},{"name":"$(T last_save)","value": "${LAST_WORLD_SAVE_TS}","inline":true},{"name":"seed","value": "${CURRENT_SEED}","inline":true},{"name":"$(T online)","value": "${LIGHTONLINELIST}","inline":true},{"name":"$(T offline)","value": "${LIGHTOFFLINELIST}","inline":true},{"name":"$(T last_check)","value": "$(date +'%F.%T')"}]}]}"
	fi
	exit 0
fi

