#!/bin/bash
# author: laryakan, date 2021/03/12

# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/crash.log"

# Test by-pass
if [ $DEBUGMODE -eq 1 ]; 
then
   source "$CWD/.env.test"
else
   source "$CWD/.env"
fi

# Valheim Server log filter
# This script brings a Valheim Log Management which doesn't exist directly through steamcmd and Valheim server ATM
# YOU NEED TO PIPE YOUR VALHEIM SERVER START SCRIPT ON THIS, no matter how, the vss.standalone.pipe do this with a tail

# Read log lines from STDIN to filter server logs and distribute them
# This file is registering online/offline players
# Filter to remove debug dans blanks
NO_DEBUG_FILTER="/^[[:space:]]*$/d;/^$/d;/Debug/d"

mkdir -p "$VALHEIMSERVERLOGDIR" $( dirname "$CONNECTEDPLAYERSFILE" ) $( dirname "$OFFLINEPLAYERSFILE" ) $( dirname "$STEAMIDMAPFILE" ) $( dirname "$LAST_WORLD_SAVE_FILE" )
touch "$CONNECTEDPLAYERSFILE" "$OFFLINEPLAYERSFILE" "$STEAMIDMAPFILE" "$LAST_WORLD_SAVE_FILE"

STEAMIDMAPFILE="${STEAMIDMAPFILE:-$CWD/data/steamid-player-map}"
LAST_WORLD_SAVE_FILE="${LAST_WORLD_SAVE_FILE:-$CWD/data/last-world-save}"
CURRENT_STEAMID=""

while read LINE; do
   # Remove debug and blank lines
   if [ "$1" != '--tail-pipe-input' ]
   then
      echo ${LINE} |sed "$NO_DEBUG_FILTER" >> "$VALHEIMSERVERLOGDIR/`date +%Y-%m-%d`.stdout.log" 
   fi

   # Capture a current SteamID from the opening connection stack line.
   # Keep it as session context across the following log lines until a
   # new SteamID token arrives, so the later ZDOID line can complete the
   # stable map as SteamID;player;ZDOID.
   if [[ "$LINE" =~ Got[[:space:]]connection[[:space:]]SteamID[[:space:]]+([^[:space:]]+) ]]; then
      CURRENT_STEAMID="${BASH_REMATCH[1]}"
   fi

   if [[ "$LINE" =~ Got[[:space:]]handshake[[:space:]]from[[:space:]]client.*SteamID[[:space:]]+([^[:space:]]+) ]]; then
      CURRENT_STEAMID="${BASH_REMATCH[1]}"
   fi

   # Detect Valheim server version update
   if [[ "$LINE" =~ ^([0-9]{2}/[0-9]{2}/[0-9]{4})[[:space:]]([0-9]{2}:[0-9]{2}:[0-9]{2})(:)?[[:space:]]*Valheim[[:space:]]version[[:space:]:-]*([A-Za-z0-9._-]+) ]]; then
      VERSION_TS="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
      FOUND_VERSION="${BASH_REMATCH[4]}"
      if [ "${VALSERVERVERSION:-0.0.0}" != "$FOUND_VERSION" ]; then
         sed -i "s|^VALSERVERVERSION=.*|VALSERVERVERSION=\"${FOUND_VERSION}\"|" "$CWD/.env"
         sed -i "s|^VALSERVERLASTUPDATE=.*|VALSERVERLASTUPDATE=\"${VERSION_TS}\"|" "$CWD/.env"
         VALSERVERVERSION="$FOUND_VERSION"
         VALSERVERLASTUPDATE="$VERSION_TS"
      fi

      if [ $DEBUGMODE -eq 1 ]
      then
         echo -e "\n\nDetected Valheim server version update: $FOUND_VERSION at $VERSION_TS"
      fi
   fi

   # Detect final world save completion and persist the save timestamp for status output
   # We only care about the final save step, exactly as in: "09/09/2026 23:55:30: World save (5/5) done. Total time [420ms]"
   if [[ "$LINE" =~ ^([0-9]{2}/[0-9]{2}/[0-9]{4})[[:space:]]([0-9]{2}:[0-9]{2}:[0-9]{2})(:)?[[:space:]]*World[[:space:]]save[[:space:]]\(5/5\)[[:space:]]done\.[[:space:]]*Total[[:space:]]time[[:space:]]\[[^]]+\] ]]; then
      SAVE_TS="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
      printf '%s\n' "$SAVE_TS" > "$LAST_WORLD_SAVE_FILE"

      if [ $DEBUGMODE -eq 1 ]
      then
         echo -e "\n\nDetected world save completion: $SAVE_TS"
      fi
   fi
   
   # Detect a synthetic respawn/spawn marker 0:0 for a player already known
   # by name in the connected/offline roster and classify it as a death event.
   DEATH_MARKER=$(echo "${LINE}" | grep "Got character ZDOID from" | head -1 | grep -E ' : 0:0$' || true)
   if [ -n "$DEATH_MARKER" ]
   then
      PLAYERNAME=$(printf '%s\n' "$DEATH_MARKER" | sed -E 's/.*Got character ZDOID from ([^[:space:]]+) .*: 0:0$/\1/')
      if [ -n "$PLAYERNAME" ] && grep -q -- "$PLAYERNAME;" "$CONNECTEDPLAYERSFILE" 2>/dev/null
      then
         if [ $EVENTREALTIME != 0 ]
         then
            "$CWD/discord/event" "death" "" "$PLAYERNAME" | "$CWD/discord/webhook.json-sender"
         fi

         if [ $DEBUGMODE -eq 1 ]
         then
            "$CWD/discord/event" "death" "" "$PLAYERNAME"
         fi
      fi
   fi

   # Get connected players
   CONNECTION=`echo ${LINE} |grep "Got character ZDOID from"|head -1`
   if [ ! -z "$CONNECTION" ]
   then
      # Parse a stable player identity chain from the log line.
      # Accept only a positive player identifier and an instance number. Ignore
      # the 0:0 spawn/respawn token and any malformed or negative chain.
      PZ=$(printf '%s\n' "$CONNECTION" | sed -E 's/.*Got character ZDOID from ([^[:space:]]+) .*: ([0-9-]+):1$/\1;\2/')
      if [ -n "$PZ" ] && printf '%s' "$PZ" | grep -q ';'; then
         PLAYERNAME="${PZ%%;*}"
         ZDOID="${PZ#*;}"
      else
         PLAYERNAME=""
         ZDOID=""
      fi

      if [ -n "$PLAYERNAME" ] && [ -n "$ZDOID" ]
      then
         CHOUR=`date +'%F.%T'`

         # Connection default event
         EVENT_TYPE="connect"

         # Persist the cross-reference SteamID -> player name / ZDOID from the same login stack.
         # Close the sequence immediately after the ZDOID line is consumed:
         # the SteamID is only valid while the connection stack is being matched.
         ALREADYKNOWN=1
         if [ -n "$CURRENT_STEAMID" ] && [ -n "$PLAYERNAME" ]; then
            ALREADYKNOWN=$(grep "^${CURRENT_STEAMID};${PLAYERNAME}$" "$STEAMIDMAPFILE")
            if [ -z "$ALREADYKNOWN" ]
            then
               # Player is not known to the server yet, its a new player.
               echo "${CURRENT_STEAMID};${PLAYERNAME}" >> "$STEAMIDMAPFILE"
               EVENT_TYPE="first_join"
            fi
             
            if [ $DEBUGMODE -eq 1 ]
            then
               echo -e "\n\nDEBUG: Detected SteamID mapping: ${CURRENT_STEAMID};${PLAYERNAME}, event type: $EVENT_TYPE"
            fi
         fi
         CURRENT_STEAMID=""

         # Remove from offline players list when the same player reconnects.
         sed -i "/;$PLAYERNAME;/d" "$OFFLINEPLAYERSFILE"
         sed -i '/^$/d' "$OFFLINEPLAYERSFILE"

         echo -e "$CHOUR;$PLAYERNAME;$ZDOID" >> "$CONNECTEDPLAYERSFILE"
         sed -i '/^$/d' "$CONNECTEDPLAYERSFILE"
         if [ $EVENTREALTIME != 0 ]
         then
            "$CWD/discord/event" "$EVENT_TYPE" "" "$PLAYERNAME" | "$CWD/discord/webhook.json-sender"
         fi

         if [ $DEBUGMODE -eq 1 ]
         then
            echo -e "\n\nDEBUG: sending event \"$EVENT_TYPE\" for player $PLAYERNAME"
            "$CWD/discord/event" "$EVENT_TYPE" "" "$PLAYERNAME"
         fi
      fi
   fi

   # Get disconnected players
   DISCOZDOID=$(echo "${LINE}" | grep "Destroying abandoned non persistent zdo" | head -1 | sed -E 's/.*Destroying abandoned non persistent zdo ([0-9-]+):[0-9]+.*$/\1/')
   if [ ! -z "$DISCOZDOID" ]
   then
      PLAYERNAME=$(grep -- "$DISCOZDOID" "$CONNECTEDPLAYERSFILE" 2>/dev/null | cut -d';' -f2 | head -n 1)
      if [ -n "$PLAYERNAME" ]
      then
         # Add to offline players list, then delete from online players
         # Keep file structures compact and safe: skip any blank/empty player line.
         grep -- "$DISCOZDOID" "$CONNECTEDPLAYERSFILE" >> "$OFFLINEPLAYERSFILE"
         sed -i "/;$DISCOZDOID/d" "$CONNECTEDPLAYERSFILE"
         # Ensure no accidental blank player records remain anywhere in the player lists.
         sed -i '/^$/d' "$CONNECTEDPLAYERSFILE"
         sed -i '/^$/d' "$OFFLINEPLAYERSFILE"
         if [ $EVENTREALTIME != 0 ]
         then
            "$CWD/discord/event" "disconnect" "" "$PLAYERNAME" | "$CWD/discord/webhook.json-sender"
         fi
         if [ $DEBUGMODE -eq 1 ]
         then
            echo -e "\n\nDEBUG: sending event \"disconnect\" for player $PLAYERNAME"
            "$CWD/discord/event" "disconnect" "" "$PLAYERNAME"
         fi
      fi
   fi



done

