#!/bin/bash
# author: laryakan, date 2021/03/12

CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
source "$CWD/lib/config.sh"
vss_load_config "$CWD" || exit 1

# Test by-pass
# Valheim Server log filter
# This script brings a Valheim Log Management which doesn't exist directly through steamcmd and Valheim server ATM
# YOU NEED TO PIPE YOUR VALHEIM SERVER START SCRIPT ON THIS, no matter how, the vss.standalone.pipe do this with a tail

# Read log lines from STDIN to filter server logs and distribute them
# This file is registering online/offline players
mkdir -p "$VALHEIMSERVERLOGDIR" $( dirname "$CONNECTEDPLAYERSFILE" ) $( dirname "$OFFLINEPLAYERSFILE" ) $( dirname "$STEAMIDMAPFILE" ) $( dirname "$LASTWORLDSAVEFILE" )
touch "$CONNECTEDPLAYERSFILE" "$OFFLINEPLAYERSFILE" "$STEAMIDMAPFILE" "$LASTWORLDSAVEFILE"

STEAMIDMAPFILE="${STEAMIDMAPFILE:-$CWD/data/steamid-player-map}"
LASTWORLDSAVEFILE="${LASTWORLDSAVEFILE:-$CWD/data/last-world-save}"
CURRENT_STEAMID=""
UNITY_TIMESTAMP='[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}:'

record_profile_value() {
   local key="$1" value="$2"
   if grep -q "^${key}=" "$VSS_ENV_FILE"; then
      sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$VSS_ENV_FILE"
   else
      printf '\n%s="%s"\n' "$key" "$value" >> "$VSS_ENV_FILE"
   fi
}

record_version_change() {
   local label="$1" version_key="$2" timestamp_key="$3" found_version="$4"
   local current_version="${!version_key:-0.0.0}"

   [ "$current_version" != "$found_version" ] || return 0
   if [ -z "$CAPTURE_TS" ]; then
      printf 'Could not timestamp %s version for profile %s.\n' "$label" "$VSS_SERVER_NAME" >&2
      return 1
   fi
   if record_profile_value "$timestamp_key" "$CAPTURE_TS" &&
      record_profile_value "$version_key" "$found_version"; then
      printf -v "$version_key" '%s' "$found_version"
      printf -v "$timestamp_key" '%s' "$CAPTURE_TS"
   else
      printf 'Could not record %s version for profile %s.\n' "$label" "$VSS_SERVER_NAME" >&2
      return 1
   fi
}

while read LINE; do
   case "$LINE" in
   "Failed to hook dlsym, ignoring it. Error: no such function: dlsym"|"Failed to hook dup2, ignoring it. Error: no such function: dup2")
      continue
      ;;
   esac

   CAPTURE_TIME=''
   CAPTURE_TS=''
   if CAPTURE_CLOCK="$(date +'%F %T|%d/%m/%Y %H:%M:%S')"; then
      CAPTURE_TIME="${CAPTURE_CLOCK%%|*}"
      CAPTURE_TS="${CAPTURE_CLOCK#*|}"
   else
      printf 'Could not timestamp log line for profile %s.\n' "$VSS_SERVER_NAME" >&2
   fi

   # Remove debug and blank lines
   if [ "$1" != '--tail-pipe-input' ]
   then
      if [[ ! "$LINE" =~ ^[[:space:]]*$ && "$LINE" != *Debug* ]]; then
         if [ -n "$CAPTURE_TS" ]; then
            LOG_LINE="$LINE"
            if [[ "$LINE" =~ ^(\[[^][]+:[[:space:]]*Unity[[:space:]]+Log\][[:space:]]+)${UNITY_TIMESTAMP}[[:space:]](.*)$ ]]; then
               LOG_LINE="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
            elif [ "${VSSBEPINEXENABLED:-0}" -eq 0 ] &&
                 [[ "$LINE" =~ ^${UNITY_TIMESTAMP}[[:space:]](.*)$ ]]; then
               LOG_LINE="${BASH_REMATCH[1]}"
            fi
            printf '%s: %s\n' "$CAPTURE_TS" "$LOG_LINE"
         else
            printf '%s\n' "$LINE"
         fi >> "$VALHEIMSERVERLOGDIR/$(date +%Y-%m-%d).$VSS_SERVER_NAME.stdout.log"
      fi
   fi

   # Detect server start and online player cleaning routine
   # Pattern : 09/27/2026 05:15:27: Loading first scene!
   # Pattern : 09/27/2026 09:46:40: Connections 0 ZDOS:487114 sent:0 recv:0
   if [[ "$LINE" == *"Loading first scene"* ]] ||
      [[ "$LINE" =~ Connections[[:space:]]+0([[:space:]]|$) ]]
   then
      # If the server has just started, or if it tells us that nobody is online, clean up the online-players file
      cat "$CONNECTEDPLAYERSFILE" >> "$OFFLINEPLAYERSFILE"
      : > "$CONNECTEDPLAYERSFILE"

      # Cleaning offline players
      sort -u "$OFFLINEPLAYERSFILE" -o "$OFFLINEPLAYERSFILE"
   fi

   # Capture a current SteamID from the opening connection stack line.
   # Keep it as session context across the following log lines until a
   # new SteamID token arrives, so the later ZDOID line can complete the
   # stable map as SteamID;player;ZDOID.
   if [[ "$LINE" =~ Got[[:space:]]connection[[:space:]]SteamID[[:space:]]+([^[:space:]]+) ]]; then
      CURRENT_STEAMID="${BASH_REMATCH[1]}"
   fi

   if [[ "$LINE" =~ Got[[:space:]]handshake[[:space:]]from[[:space:]]client.*SteamID[[:space:]]+([^[:space:]]+) ]]; then
      CURRENT_STEAMID="${BASH_REMATCH[1]}"
   fi

   if [[ "$LINE" =~ (^|[[:space:]])Opened[[:space:]]+(Steam|PlayFab)[[:space:]]+server[[:space:]]*$ ]]; then
      if [ -z "$CAPTURE_TIME" ]; then
         printf 'Could not timestamp server opening for profile %s.\n' "$VSS_SERVER_NAME" >&2
      elif ! record_profile_value VALSERVERLASTOPEN "$CAPTURE_TIME"; then
         printf 'Could not record server opening for profile %s.\n' "$VSS_SERVER_NAME" >&2
      fi
   fi

   # Detect Valheim server version update
   if [[ "$LINE" =~ Valheim[[:space:]]+version[[:space:]:-]*([A-Za-z0-9._-]+) ]]; then
      FOUND_VERSION="${BASH_REMATCH[1]}"
      if record_version_change Valheim VALSERVERVERSION VALSERVERLASTUPDATE "$FOUND_VERSION" &&
         [ "${DEBUGMODE:-0}" -eq 1 ]; then
         echo -e "\n\nDetected Valheim server version: $FOUND_VERSION at $CAPTURE_TS"
      fi
   fi

   # Detect BepInEx Version if activated
   if [ "${VSSBEPINEXENABLED:-0}" -eq 1 ];
   then
      if [[ "$LINE" =~ \[Message:[[:space:]]+BepInEx\][[:space:]]+BepInEx[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)[[:space:]]+-[[:space:]]+[A-Za-z0-9_-]+([[:space:]]|$) ]]; then
         FOUND_VERSION="${BASH_REMATCH[1]}"
         record_version_change BepInEx BEPINEXVERSION BEPINEXLASTUPDATE "$FOUND_VERSION"
      fi
   fi

   # Detect final world save completion and persist the save timestamp for status output
   # We only care about the final save step, exactly as in: "09/09/2026 23:55:30: World save (5/5) done. Total time [420ms]"
   if [[ "$LINE" =~ World[[:space:]]+save[[:space:]]+\(5/5\)[[:space:]]+done\.[[:space:]]*Total[[:space:]]+time[[:space:]]*\[[^]]+\] ]]; then
      if [ -z "$CAPTURE_TS" ]; then
         printf 'Could not timestamp world save for profile %s.\n' "$VSS_SERVER_NAME" >&2
      else
         printf '%s\n' "$CAPTURE_TS" > "$LASTWORLDSAVEFILE"

         if [ "${DEBUGMODE:-0}" -eq 1 ];
         then
            echo -e "\n\nDetected world save completion: $CAPTURE_TS"
         fi
      fi
   fi
   
   # Detect a synthetic respawn/spawn marker 0:0 for a player already known
   # by name in the connected/offline roster and classify it as a death event.
   DEATH_MARKER=$(echo "${LINE}" | grep "Got character ZDOID from" | head -1 | grep -E ' : 0:0$' || true)
   if [ -n "$DEATH_MARKER" ]
   then
      PLAYERNAME=$(printf '%s\n' "$DEATH_MARKER" | sed -E 's/.*Got character ZDOID from ([^[:space:]]+) .*: 0:0$/\1/')
      if [ -n "$PLAYERNAME" ] && grep -q -- "$PLAYERNAME;" "$CONNECTEDPLAYERSFILE" 2>/dev/null
      then
         if [ $EVENTREALTIME != 0 ]
         then
            "$CWD/discord/event" "death" "" "$PLAYERNAME" | "$CWD/discord/webhook.json-sender"
         fi

         if [ "${DEBUGMODE:-0}" -eq 1 ];
         then
            "$CWD/discord/event" "death" "" "$PLAYERNAME"
         fi
      fi
   fi

   # Get connected players
   CONNECTION=`echo ${LINE} |grep "Got character ZDOID from"|head -1`
   if [ ! -z "$CONNECTION" ]
   then
      # Parse a stable player identity chain from the log line.
      # Accept only a positive player identifier and an instance number. Ignore
      # the 0:0 spawn/respawn token and any malformed or negative chain.
      PZ=$(printf '%s\n' "$CONNECTION" | sed -E 's/.*Got character ZDOID from ([^[:space:]]+) .*: ([0-9-]+):[1-9]\d?$/\1;\2/')
      if [ -n "$PZ" ] && printf '%s' "$PZ" | grep -q ';'; then
         PLAYERNAME="${PZ%%;*}"
         ZDOID="${PZ#*;}"
      else
         PLAYERNAME=""
         ZDOID=""
      fi

      if [ -n "$PLAYERNAME" ] && [ -n "$ZDOID" ]
      then

         # Check if already listed as connected: Then do nothing
         if grep -q "${PLAYERNAME}" "$CONNECTEDPLAYERSFILE" 2>/dev/null;
         then
            continue
         fi

         CHOUR=`date +'%F.%T'`

         # Connection default event
         EVENT_TYPE="connect"

         # Persist the cross-reference SteamID -> player name / ZDOID from the same login stack.
         # Close the sequence immediately after the ZDOID line is consumed:
         # the SteamID is only valid while the connection stack is being matched.
         ALREADYKNOWN=1
         if [ -n "$CURRENT_STEAMID" ] && [ -n "$PLAYERNAME" ]; then
            ALREADYKNOWN=$(grep "^${CURRENT_STEAMID};${PLAYERNAME}$" "$STEAMIDMAPFILE")
            if [ -z "$ALREADYKNOWN" ]
            then
               # Player is not known to the server yet, its a new player.
               echo "${CURRENT_STEAMID};${PLAYERNAME}" >> "$STEAMIDMAPFILE"
               EVENT_TYPE="first_join"
            fi
             
            if [ "${DEBUGMODE:-0}" -eq 1 ];
            then
               echo -e "\n\nDEBUG: Detected SteamID mapping: ${CURRENT_STEAMID};${PLAYERNAME}, event type: $EVENT_TYPE"
            fi
         fi
         CURRENT_STEAMID=""

         # Remove from offline players list when the same player reconnects.
         sed -i "/;$PLAYERNAME;/d" "$OFFLINEPLAYERSFILE"
         sed -i '/^$/d' "$OFFLINEPLAYERSFILE"

         echo -e "$CHOUR;$PLAYERNAME;$ZDOID" >> "$CONNECTEDPLAYERSFILE"
         sed -i '/^$/d' "$CONNECTEDPLAYERSFILE"
         if [ $EVENTREALTIME != 0 ]
         then
            "$CWD/discord/event" "$EVENT_TYPE" "" "$PLAYERNAME" | "$CWD/discord/webhook.json-sender"
         fi

         if [ "${DEBUGMODE:-0}" -eq 1 ];
         then
            echo -e "\n\nDEBUG: sending event \"$EVENT_TYPE\" for player $PLAYERNAME"
            "$CWD/discord/event" "$EVENT_TYPE" "" "$PLAYERNAME"
         fi
      fi
   fi

   # Get disconnected players
   DISCOZDOID=$(echo "${LINE}" | grep "Destroying abandoned non persistent zdo" | head -1 | sed -E 's/.*Destroying abandoned non persistent zdo ([0-9-]+):[0-9]+.*$/\1/')
   if [ ! -z "$DISCOZDOID" ]
   then
      PLAYERNAME=$(grep -- "$DISCOZDOID" "$CONNECTEDPLAYERSFILE" 2>/dev/null | cut -d';' -f2 | head -n 1)
      if [ -n "$PLAYERNAME" ]
      then
         # Add to offline players list, then delete from online players
         # Keep file structures compact and safe: skip any blank/empty player line.
         grep -- "$DISCOZDOID" "$CONNECTEDPLAYERSFILE" >> "$OFFLINEPLAYERSFILE"
         sed -i "/;$DISCOZDOID/d" "$CONNECTEDPLAYERSFILE"
         # Ensure no accidental blank player records remain anywhere in the player lists.
         sed -i '/^$/d' "$CONNECTEDPLAYERSFILE"
         sed -i '/^$/d' "$OFFLINEPLAYERSFILE"
         if [ $EVENTREALTIME != 0 ]
         then
            "$CWD/discord/event" "disconnect" "" "$PLAYERNAME" | "$CWD/discord/webhook.json-sender"
         fi
         if [ "${DEBUGMODE:-0}" -eq 1 ];
         then
            echo -e "\n\nDEBUG: sending event \"disconnect\" for player $PLAYERNAME"
            "$CWD/discord/event" "disconnect" "" "$PLAYERNAME"
         fi
      fi
   fi



done

