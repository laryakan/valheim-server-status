#!/bin/bash
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/../crash.log"
source "$CWD/../.env"
source "$CWD/../i18n.sh"

json_escape() {
  local value="${1}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

EVENT_TYPE="${1:-unknown}"
EVENT_MESSAGE="${2:-}"
PLAYER_NAME="${3:-}"
EVENT_TIME="$(date +'%F.%T')"

if [ -n "$EVENT_MESSAGE" ]
then
  EVENT_TEXT="$EVENT_MESSAGE"
else
  EVENT_TEXT="$(T event_line "$EVENT_TYPE")"
fi

PLAYER_FIELD=''
if [ -n "$PLAYER_NAME" ]; then
  PLAYER_FIELD="{\"name\":\"$(json_escape "$(T player)")\",\"value\":\"$(json_escape "$PLAYER_NAME")\"},"
fi

PAYLOAD=$(cat <<EOF
{
  "title":"$(json_escape "$(T event_title)")",
  "embeds":[
    {
      "title":"$(json_escape "$EVENT_TYPE")",
      "color":10181046,
      "url":"$(json_escape "$STATUSURL")",
      "fields":[
        {"name":"$(json_escape "$(T event_time)")","value":"$(json_escape "$EVENT_TIME")"},
        ${PLAYER_FIELD}
        {"name":"$(json_escape "$(T status)")","value":"$(json_escape "$EVENT_TEXT")"}
      ]
    }
  ]
}
EOF
)

printf '%s' "$PAYLOAD"
