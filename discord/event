#!/bin/bash
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/../crash.log"
source "$CWD/../.env"
source "$CWD/../i18n.sh"

json_escape() {
  local value="${1}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

EVENT_TYPE="${1:-unknown}"
EVENT_MESSAGE="${2:-}"
PLAYER_NAME="${3:-}"

if [ -n "$EVENT_MESSAGE" ]
then
  EVENT_TEXT="$EVENT_MESSAGE"
else
  EVENT_TEXT="$(T event_line "$EVENT_TYPE")"
fi

if [ -n "$PLAYER_NAME" ] && [[ "$EVENT_TEXT" != *"$PLAYER_NAME"* ]]; then
  EVENT_TEXT="${EVENT_TEXT} (${PLAYER_NAME})"
fi

TITLE="$(T player_connected)"
case "$EVENT_TYPE" in
  disconnect)
    TITLE="$(T player_disconnected)"
    ;;
  first_join)
    TITLE="$(T first_connection)"
    ;;
  death)
    TITLE="$(T player_died)"
    ;;
  *)
    TITLE="$(T player_connected)"
    ;;
esac

printf '%s' "{
  \"title\": \"$(json_escape "$(T event_title)")\",
  \"embeds\": [{
    \"title\": \"$(json_escape "$TITLE")\",
    \"color\": 10181046,
    \"description\": \"$(json_escape "$EVENT_TEXT")\"
  }]
}"
