#!/bin/bash
# author: laryakan, date 2021/03/12
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/../crash.log"
# Test by-pass
if [ "${DEBUGMODE:-0}" -eq 1 ];
then
   source "$CWD/../.env.test"
else
   source "$CWD/../.env"
fi
source "$CWD/../i18n.sh"

# Sending status messages on Discord script
CWD=$(dirname "$0")
MESSAGEID="$STATUSMESSAGEID"
WEBHOOKID="$WEBHOOKID"
WEBHOOKTOKEN="$WEBHOOKTOKEN"

# help
if [ "$1" = "-h" ]
then
	echo -e "$(T usage)"
	exit 0
fi

# Not status send
if [ "$1" != "--status" ]
then
	MESSAGEID="$1"
fi
CONTENT="$(</dev/stdin)"

# Discord URL Webhook, chan "valheim-server" on Superf*ckfriends
WHURL="https://discord.com/api/webhooks/$WEBHOOKID/$WEBHOOKTOKEN"

# Check if a status message_id has been filled
if [ -n "${MESSAGEID:-}" ]
then
	case "$MESSAGEID" in
		''|*[!0-9]*) MESSAGEID='' ;;
		*) ;;
	esac
fi

if [ -n "${MESSAGEID:-}" ]
then
	PATCH_RESPONSE_FILE="$(mktemp)"
	PATCH_HTTP_CODE=$(curl -sS -o "$PATCH_RESPONSE_FILE" -w '%{http_code}' -H "Content-Type: application/json" -X PATCH -d "$CONTENT" "$WHURL/messages/$MESSAGEID")
	PATCH_BODY=$(cat "$PATCH_RESPONSE_FILE")
	PATCH_DELETED=$(printf '%s' "$PATCH_BODY" | grep -E '"code"[[:space:]]*:[[:space:]]*10008|Unknown Message|Unknown Webhook|message.*not found|not found' || true)

	case "$PATCH_HTTP_CODE" in
		200|201|202|204)
			exit 0
			;;
		*)
			if [ -n "$PATCH_DELETED" ]
			then
				if [ "$1" = "--status" ]
				then
					echo -e "Status message has been deleted from the server, \
	a new message will be sent, please fill the .env file. | Content : "$CONTENT" "$WHURL/messages/$MESSAGEID"" >&2
				fi
				MESSAGEID=''
			else
				echo -e "$(T patch_failed "$PATCH_HTTP_CODE") | Content : "$CONTENT" "$WHURL/messages/$MESSAGEID"" >&2
				exit 0
			fi
			;;
	esac
fi

#'{"content":"'"${domain} : ${status_code}"'"}'
if [ "${DEBUGMODE:-0}" -eq 1 ];
then
	echo -e "curl -sS -H \"Content-Type: application/json\" -X POST -d '$CONTENT' \"$WHURL\""
	exit 0
fi
curl -sS -H "Content-Type: application/json" -X POST -d "$CONTENT" "$WHURL"
