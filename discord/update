#!/bin/bash
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/../crash.log"
source "$CWD/../.env"
source "$CWD/../i18n.sh"
# Output the server connection info first if asked.
if [ "${SENDSERVERCONNECTIONINFO:-0}" -gt 0 ] 2>/dev/null
then
  "$CWD/connection-info" | "$CWD/webhook.json-sender" "$SERVERCONNECTIONINFOMESSAGEID"
  sleep 2
fi

# Update server status second.
"$VSSDIR/status/server-status" --for-webhook | "$CWD/webhook.json-sender" --status
sleep 2

# Output the last stdout logs last if asked.
if [ "${SENDLASTLOGS:-0}" -gt 0 ] 2>/dev/null
then
  "$CWD/last-logs" | "$CWD/webhook.json-sender" "$LASTLOGMESSAGEID"
fi

