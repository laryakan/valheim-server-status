#!/bin/bash
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
exec 2>>"$CWD/../crash.log"
source "$CWD/../lib/config.sh"
vss_load_config "$CWD/.." || exit 1
source "$CWD/../i18n.sh"
# Update the profile status, including connection details when enabled.
"$VSSDIR/status/server-status" --for-webhook | "$CWD/webhook.json-sender" --status

