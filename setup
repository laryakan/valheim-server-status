function reset_profile_world() {
  local confirmation
  local running_pid
  local world_files_dir="$VHSERVERSAVEDIR/worlds_local"
  local server_was_active=0

  VSS_SETUP_NOTICE=''
  if [ -z "$VHSERVERWORLD" ]; then
    VSS_SETUP_NOTICE='World name is empty; no save files were changed.'
    return 1
  fi

  printf 'This permanently deletes the local save files for world %s.\n' "$VHSERVERWORLD"
  printf 'Type DELETE WORLD to continue: '
  read -r confirmation || return 1
  if [ "$confirmation" != 'DELETE WORLD' ]; then
    VSS_SETUP_NOTICE='World reset cancelled; no save files were changed.'
    return 0
  fi

  if systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    server_was_active=1
    if ! stop_valheim_service; then
      VSS_SETUP_NOTICE='Could not stop the Valheim service; world files were not changed.'
      return 1
    fi
  else
    running_pid="$(vss_find_server_pid || true)"
    if [ -n "$running_pid" ]; then
      VSS_SETUP_NOTICE="Valheim is running outside its systemd service (PID $running_pid); world files were not changed."
      return 1
    fi
  fi

  if ! mkdir -p -- "$world_files_dir" ||
     ! find "$world_files_dir" -maxdepth 1 -type f \
       \( -name "${VHSERVERWORLD}.fwl" -o -name "${VHSERVERWORLD}.db" \
          -o -name "${VHSERVERWORLD}*.fwl" -o -name "${VHSERVERWORLD}*.db" \) \
       -print -delete; then
    VSS_SETUP_NOTICE="Could not remove save files for $VHSERVERWORLD."
    if [ "$server_was_active" -eq 1 ] && ! start_valheim_service; then
      VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
    fi
    return 1
  fi

  if [ "$server_was_active" -eq 1 ]; then
    if ! start_valheim_service; then
      VSS_SETUP_NOTICE="World files for $VHSERVERWORLD were removed, but the server could not be restarted."
      return 1
    fi
    VSS_SETUP_NOTICE="World files for $VHSERVERWORLD were removed and its previously running server was restarted."
  else
    VSS_SETUP_NOTICE="World files for $VHSERVERWORLD were removed; the server remains stopped."
  fi
  return 0
}

function launcher_menu() {
  local choice
  local selected=1
  local notice=''
  while true; do
    setup_menu_render 'Valheim server' "$notice"
    notice=''
    printf 'Server directory and save directory are shared by all profiles.\n\n'
    setup_ui_menu_option "$selected" 1 'Detect settings from a running VSS server'
    setup_ui_menu_option "$selected" 2 'Set shared Valheim server directory'
    setup_ui_menu_option "$selected" 3 'Set this profile game port'
    setup_ui_menu_option "$selected" 4 'Set this profile server display name'
    setup_ui_menu_option "$selected" 5 'Show world/profile ID (read-only)'
    setup_ui_menu_option "$selected" 6 'Set this profile server password'
    setup_ui_menu_option "$selected" 7 'Set informational world seed'
    setup_ui_menu_option "$selected" 8 'Set shared Valheim save directory'
    setup_ui_menu_option "$selected" 9 'Set crossplay (1=yes, 0=no)'
    setup_ui_menu_option "$selected" 10 'Install or update this profile server service'
    setup_ui_menu_option "$selected" 11 'Remove this profile server service'
    setup_ui_menu_option "$selected" 12 'Stop this profile server'
    setup_ui_menu_option "$selected" 13 'Start this profile server'
    setup_ui_menu_option "$selected" 14 'Restart this profile server'
    setup_ui_menu_option "$selected" 15 'Reset this world save (confirmation required)'
    printf '\n'
    setup_ui_menu_option "$selected" 0 'Return'
    printf '\n'
    printf 'Select an action: '
    setup_ui_read_menu_choice 15 "$selected" || return 0
    choice="$SETUP_UI_CHOICE"
    if [ "$choice" = '__redraw__' ]; then
      selected="$SETUP_UI_SELECTED_CHOICE"
      continue
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] && (( choice <= 15 )) && selected="$choice"
    case "$choice" in
      1)
        if auto_conf; then notice='Detected settings were applied.'
        else notice='Could not detect settings; review the error above.'; fi
        ;;
      2)
        if setup_value_prompt 'Shared Valheim server directory' VHSERVERDIR; then notice='Server directory updated.'
        else notice='Server directory was not changed.'; fi
        ;;
      3)
        if setup_value_prompt 'Valheim game port for this profile' VHSERVERPORT; then notice='Game port updated.'
        else notice='Game port was not changed.'; fi
        ;;
      4)
        if setup_value_prompt 'Valheim server display name' VHSERVERNAME; then notice='Server display name updated.'
        else notice='Server display name was not changed.'; fi
        ;;
      5) notice="World/profile ID: $VHSERVERWORLD (rename is not supported here)." ;;
      6)
        if setup_value_prompt 'Valheim server password (hidden)' VHSERVERPASSWD; then notice='Server password updated.'
        else notice='Server password was not changed.'; fi
        ;;
      7)
        if setup_value_prompt 'Informational world seed' VHSERVERSEED; then notice='Informational seed updated.'
        else notice='Informational seed was not changed.'; fi
        ;;
      8)
        if setup_value_prompt 'Shared Valheim save directory' VHSERVERSAVEDIR; then notice='Save directory updated.'
        else notice='Save directory was not changed.'; fi
        ;;
      9)
        if setup_value_prompt 'Crossplay (1=yes, 0=no)' VHSERVERCROSSPLAY; then notice='Crossplay setting updated.'
        else notice='Crossplay setting was not changed.'; fi
        ;;
      10)
        if set_service "$VHSERVERSERVICENAME"; then notice='Valheim service installed and started.'
        else notice='Could not install or start the Valheim service; review the error above.'; fi
        ;;
      11)
        if uninstall_service "$VHSERVERSERVICENAME"; then notice='Valheim service removed.'
        else notice='Valheim service removal failed; its remaining state was kept for recovery.'; fi
        ;;
      12)
        if stop_valheim_service; then notice='Valheim service stopped.'
        else notice='Could not stop the Valheim service; review its status.'; fi
        ;;
      13)
        if start_valheim_service; then notice='Valheim service started.'
        else notice='Could not start the Valheim service; review its status.'; fi
        ;;
      14)
        if restart_valheim_service; then notice='Valheim service restarted.'
        else notice='Could not restart the Valheim service; review its status.'; fi
        ;;
      15)
        if reset_profile_world; then notice="${VSS_SETUP_NOTICE:-World reset completed.}"
        else notice="${VSS_SETUP_NOTICE:-World reset failed; review the error above.}"; fi
        ;;
      0) return 0 ;;
      *) notice="Unknown option: $choice" ;;
    esac
  done
}

function admin_menu() {
  local choice
  local selected=1
  local notice=''
  while true; do
    setup_menu_render 'Admin and access lists' "$notice"
    notice=''
    printf 'Admin, banned, and permitted lists are shared by all profiles.\n\n'
    setup_ui_menu_option "$selected" 1 'Show admin list'
    setup_ui_menu_option "$selected" 2 'Add admin'
    setup_ui_menu_option "$selected" 3 'Remove admin'
    setup_ui_menu_option "$selected" 4 'Show banned list'
    setup_ui_menu_option "$selected" 5 'Add banned player'
    setup_ui_menu_option "$selected" 6 'Remove banned player'
    setup_ui_menu_option "$selected" 7 'Show permitted list'
    setup_ui_menu_option "$selected" 8 'Add permitted player'
    setup_ui_menu_option "$selected" 9 'Remove permitted player'
    printf '\n'
    setup_ui_menu_option "$selected" 0 'Return'
    printf '\n'
    printf 'Select an action: '
    setup_ui_read_menu_choice 9 "$selected" || return 0
    choice="$SETUP_UI_CHOICE"
    if [ "$choice" = '__redraw__' ]; then
      selected="$SETUP_UI_SELECTED_CHOICE"
      continue
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] && (( choice <= 9 )) && selected="$choice"
    case "$choice" in
      1|4|7)
        case "$choice" in 1) admin_list_show admin ;; 4) admin_list_show banned ;; 7) admin_list_show permitted ;; esac
        setup_ui_pause
        notice='List displayed above.'
        ;;
      2|3|5|6|8|9)
        case "$choice" in
          2) if admin_list_add admin; then notice='Admin list updated.'; else notice='Admin list was not changed; review the error above.'; fi ;;
          3) if admin_list_remove admin; then notice='Admin list updated.'; else notice='Admin list was not changed; review the error above.'; fi ;;
          5) if admin_list_add banned; then notice='Banned list updated.'; else notice='Banned list was not changed; review the error above.'; fi ;;
          6) if admin_list_remove banned; then notice='Banned list updated.'; else notice='Banned list was not changed; review the error above.'; fi ;;
          8) if admin_list_add permitted; then notice='Permitted list updated.'; else notice='Permitted list was not changed; review the error above.'; fi ;;
          9) if admin_list_remove permitted; then notice='Permitted list updated.'; else notice='Permitted list was not changed; review the error above.'; fi ;;
        esac
        ;;
      0) return 0 ;;
      *) notice="Unknown option: $choice" ;;
    esac
  done
}

