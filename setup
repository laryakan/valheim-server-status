discord_menu(){
vss_header
echo -ne "
*** $(ColorMagenta 'Discord') menu ***
$(ColorRed 'Remember to first create your webhook on Discord and activate developer mode (in appereance menu)')
$(ColorGreen '1)') setup current $(ColorMagenta 'Discord') webhook URL
$(ColorGreen '2)') setup 'how many' wanted last logs on your $(ColorMagenta 'Discord') channel
$(ColorGreen '3)') force $(ColorMagenta 'Discord') webhook update
$(ColorGreen '4)') setup current $(ColorMagenta 'Discord') webhook status message id
$(ColorGreen '5)') setup current $(ColorMagenta 'Discord') webhook last logs message id
$(ColorGreen '6)') setup current $(ColorMagenta 'Discord') webhook connection info message id
$(ColorGreen '7)') enable or disable connection info on your webhook (1 or 0)
$(ColorGreen '8)') enable or disable realtime in-game event update on your webhook (1 or 0) (things using the log-filter have to restart)
$(ColorGreen '9)') setup webhook language (available: en, fr)
$(ColorGreen '10)') setup $(ColorMagenta 'Discord') webhook update cron frequency (Valheim Server heartbeat)
$(ColorGreen '11)') remove webhook crontab (no more auto-update)

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			1) setup_value_prompt "what's your $(ColorMagenta 'Discord') webhook url ?" 'WEBHOOKURL' ; clear ; discord_menu ;;
	        2) setup_value_prompt "how many logs do you want on your $(ColorMagenta 'Discord') ? set '0' if you dont want any" 'SENDLASTLOGS' ; clear ; discord_menu ;;
	        3) "$CWD/discord/update" ; clear ; discord_menu ;;
	        4) setup_value_prompt "what's the $(ColorMagenta 'Discord') webhook status message id ?" 'STATUSMESSAGEID' ; clear ; discord_menu ;;
	        5) setup_value_prompt "what's the $(ColorMagenta 'Discord') webhook 'last logs' message id ?" 'LASTLOGMESSAGEID' ; clear ; discord_menu ;;
			6) setup_value_prompt "what's the $(ColorMagenta 'Discord') webhook 'connection info' message id ?" 'SERVERCONNECTIONINFOMESSAGEID' ; clear ; discord_menu ;;
			7) setup_value_prompt 'do you want the connection info message to be sent to Discord ? (set "1" for true, "0" for false)' 'SENDSERVERCONNECTIONINFO' ; clear ; discord_menu ;;
			8) setup_value_prompt 'do you want the webhook messages to auto-update at each in-game event ? (set "1" for true, "0" for false)' 'EVENTREALTIME' ; clear ; discord_menu ;;
			9) setup_value_prompt 'choose your Discord webhook language (available values: en, fr)' 'VSS_LANG' ; clear ; discord_menu ;;
			10) setup_value_prompt "at which frequency do you want your $(ColorMagenta 'Discord') webhook to send message (in minutes) ? set '0' if you dont want an auto-update cron" 'CRONTABWEBHOOKFREQ' ; set_cron ; sleep 2 ; clear ; discord_menu ;;
			11) replace_env_value 'CRONTABWEBHOOKFREQ' 0 ; set_cron ; sleep 2 ; clear ; discord_menu ;;
			
		0) clear ; new_menu ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

# new menus
function admin_list_file() {
  case "$1" in
    admin) echo "$VHSERVERSAVEDIR/adminlist.txt" ;;
    banned) echo "$VHSERVERSAVEDIR/bannedlist.txt" ;;
    permitted) echo "$VHSERVERSAVEDIR/permittedlist.txt" ;;
    *) echo "$VHSERVERSAVEDIR/${1}list.txt" ;;
  esac
}

function known_players_display() {
  local known_file
  local line
  local timestamp
  local pseudo
  local player_id
  local display_entries=""

  if [ -d "$VSSDIR/data" ]; then
    for known_file in "$VSSDIR/data/online-players" "$VSSDIR/data/offline-players"; do
      if [ -f "$known_file" ]; then
        while IFS=';' read -r timestamp pseudo player_id; do
          if [ -n "$pseudo" ] && [ -n "$player_id" ]; then
            if ! printf '%s\n' "$display_entries" | grep -Fq "${pseudo}:${player_id}"; then
              if [ -n "$display_entries" ]; then
                display_entries="${display_entries} | ${pseudo}:${player_id}"
              else
                display_entries="${pseudo}:${player_id}"
              fi
            fi
          fi
        done < "$known_file"
      fi
    done

    if [ -n "$display_entries" ]; then
      echo "--- known players ---"
      echo "$display_entries"
    fi
  fi
}

function admin_list_show() {
  local list_name="$1"
  local file
  mkdir -p "$VHSERVERSAVEDIR"
  file="$(admin_list_file "$list_name")"
  if [ -f "$file" ]; then
    echo "--- ${list_name} list ---"
    cat "$file"
  else
    echo "--- ${list_name} list ---"
    echo "(empty or missing)"
  fi
}

function admin_list_add() {
  local list_name="$1"
  local player_id
  local file
  mkdir -p "$VHSERVERSAVEDIR"
  file="$(admin_list_file "$list_name")"
  known_players_display
  echo "enter player ID to add to ${list_name}:"
  read -r player_id
  if [ -z "$player_id" ]; then
    echo "empty value, aborted" >&2
    return
  fi
  if [ -f "$file" ] && grep -Fqx "$player_id" "$file"; then
    echo "$player_id already exists in ${list_name} list" >&2
    return
  fi
  echo "$player_id" >> "$file"
  echo "$player_id added to ${list_name} list"
}

function admin_list_remove() {
  local list_name="$1"
  local player_id
  local file
  local tmp_file
  mkdir -p "$VHSERVERSAVEDIR"
  file="$(admin_list_file "$list_name")"
  known_players_display
  echo "enter player ID to remove from ${list_name}:"
  read -r player_id
  if [ -z "$player_id" ]; then
    echo "empty value, aborted" >&2
    return
  fi
  if [ ! -f "$file" ] || ! grep -Fqx "$player_id" "$file"; then
    echo "$player_id not found in ${list_name} list" >&2
    return
  fi
  tmp_file="$(mktemp)"
  grep -Fvx "$player_id" "$file" > "$tmp_file"
  mv "$tmp_file" "$file"
  echo "$player_id removed from ${list_name} list"
}

launcher_menu(){
vss_header
echo -ne "
*** Valheim Server Launcher menu ***
$(ColorRed 'Warning: most launcher options only work when VSS starts the Valheim server itself. All setup option needs a server restart to take effect.')
$(ColorGreen '1)') $(ColorYellow 'auto-conf custom launcher') if your server is running! this will set 2),3),4),5),6),7),8)
$(ColorGreen '2)') setup current Valheim server directory
$(ColorGreen '3)') setup wanted Valheim server listening port
$(ColorGreen '4)') setup wanted Valheim server name
$(ColorGreen '5)') setup wanted Valheim server world name
$(ColorGreen '6)') setup wanted Valheim server password
$(ColorGreen '7)') setup wanted Valheim server $(ColorYellow 'seed') value $(ColorRed '(you will start on a new map after server restart)')
$(ColorGreen '8)') setup wanted Valheim server savedir value
$(ColorGreen '9)') setup crossplay
$(ColorGreen '10)') $(ColorRed 'sudo required') create or reinstall valheim-server.service in /etc/systemd/system
$(ColorGreen '11)') $(ColorRed 'sudo required') remove valheim-server.service from /etc/systemd/system
$(ColorGreen '12)') $(ColorRed 'sudo required') stop the existing service and shut down the server
$(ColorGreen '13)') $(ColorRed 'sudo required') start the existing service and run the server
$(ColorGreen '14)') $(ColorRed 'sudo required') restart the existing service and the server
$(ColorGreen '15)') $(ColorRed 'sudo required') $(ColorYellow 'delete my old world and start a new one (stop server, delete saved world, start server)')

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			1) auto_conf ; clear ; launcher_menu ;;
			2) setup_value_prompt 'where is located your dedicated server ?' 'VHSERVERDIR' ; clear ; launcher_menu ;;
			3) setup_value_prompt 'on which port do you want your server to listen (default: 2456) ?' 'VHSERVERPORT' ; clear ; launcher_menu ;;
	        4) setup_value_prompt "what is your $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim server name ?" 'VHSERVERNAME' ; clear ; launcher_menu ;;
	        5) setup_value_prompt "what is your $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim World name ? $(ColorRed 'If you already have a server, put its World name here')" 'VHSERVERWORLD' ; clear ; launcher_menu ;;
	        6) setup_value_prompt "what is your $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim server password ?" 'VHSERVERPASSWD' ; clear ; launcher_menu ;;
			7) setup_value_prompt "what is your wanted $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim server seed ?" 'VHSERVERSEED' ; clear ; launcher_menu ;;
			8) setup_value_prompt "what is your wanted $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim server savedir ?" 'VHSERVERSAVEDIR' ; clear ; launcher_menu ;;
			9) setup_value_prompt 'set crossplay on/off: 1 = crossplay active, 0 = crossplay inactive' 'VHSERVERCROSSPLAY' ; clear ; launcher_menu ;;
			10) set_service "$VHSERVERSERVICENAME"; sleep 2 ; clear ; launcher_menu ;;
			11) uninstall_service "$VHSERVERSERVICENAME" ; clear ; launcher_menu ;;
			12) stop_valheim_service ; sleep 2 ; clear ; launcher_menu ;;
			13) start_valheim_service ; sleep 2 ; clear ; launcher_menu ;;
			14) restart_valheim_service ; sleep 2 ; clear ; launcher_menu ;;
			15) 
				if [ -n "$VHSERVERWORLD" ]; then
					stop_valheim_service
					WORLD_FILES_DIR="$VHSERVERSAVEDIR/worlds_local"
					mkdir -p "$WORLD_FILES_DIR"
					find "$WORLD_FILES_DIR" -maxdepth 1 -type f \( -name "${VHSERVERWORLD}.fwl" -o -name "${VHSERVERWORLD}.db" -o -name "${VHSERVERWORLD}*.fwl" -o -name "${VHSERVERWORLD}*.db" \) -print -delete
					start_valheim_service
				else
					echo -e "$(ColorRed 'VHSERVERWORLD is empty; cannot delete the current world.')" >&2
				fi
				sleep 2 ; clear ; launcher_menu ;;

		0) clear ; new_menu ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

admin_menu(){
vss_header
echo -ne "
*** VSS Admin menu ***
$(ColorGreen '1)') [Show] Admin
$(ColorGreen '2)') [Add] Admin
$(ColorGreen '3)') [Remove] Admin
$(ColorGreen '4)') [Show] Banned
$(ColorGreen '5)') [Add] Banned
$(ColorGreen '6)') [Remove] Banned
$(ColorGreen '7)') [Show] Permitted
$(ColorGreen '8)') [Add] Permitted
$(ColorGreen '9)') [Remove] Permitted

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			1) admin_list_show 'admin' ; sleep 5 ; clear ; admin_menu ;;
			2) admin_list_add 'admin' ; sleep 5 ; clear ; admin_menu ;;
			3) admin_list_remove 'admin' ; sleep 5 ; clear ; admin_menu ;;
			4) admin_list_show 'banned' ; sleep 5 ; clear ; admin_menu ;;
			5) admin_list_add 'banned' ; sleep 5 ; clear ; admin_menu ;;
			6) admin_list_remove 'banned' ; sleep 5 ; clear ; admin_menu ;;
			7) admin_list_show 'permitted' ; sleep 5 ; clear ; admin_menu ;;
			8) admin_list_add 'permitted' ; sleep 5 ; clear ; admin_menu ;;
			9) admin_list_remove 'permitted' ; sleep 5 ; clear ; admin_menu ;;
		0) clear ; new_menu ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

# new menus
http_status_menu(){
vss_header
echo -ne "
*** VSS over HTTP menu ***
$(ColorGreen '1)') setup wanted Valheim server status over HTTP public URL (host:port)
$(ColorGreen '2)') $(ColorRed 'sudo required'), add and activate VSS.http.service (server status over HTTP)
$(ColorGreen '3)') $(ColorRed 'sudo required') remove VSS.http.service (server status over HTTP)

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			 1) setup_value_prompt 'set the public URL of your VSS over HTTP status (http://host:port) ?' 'STATUSURL' ; clear ; http_status_menu ;;
			 2) set_service "$VSSHTTPSERVICENAME"; sleep 2 ; clear ; http_status_menu ;;
			 3) uninstall_service "$VSSHTTPSERVICENAME" ; clear ; http_status_menu ;;

		0) clear ; new_menu ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

# Main menu
new_menu(){
vss_header
echo -ne "
*** Main menu ***
$(ColorGreen '1)') VSS $(ColorMagenta 'Discord') menu
$(ColorGreen '2)') VSS Launcher menu
$(ColorGreen '3)') VSS over HTTP menu
$(ColorGreen '4)') VSS Admin menu $(ColorRed '(only available for VSS launched server)')

** Logs **
$(ColorBlue 'we can setup a service based on tail if you already have a your server log outputting somewhere')
$(ColorBlue 'just setup a valid logs path (wildcards accepted). Then you will not need to use the custom launcher')
$(ColorGreen '5)') setup wanted Valheim Server logs path (file or directory)
* standalone *
$(ColorGreen '6)') $(ColorRed 'sudo required') add and activate vss.pipe.service (to catch events from existings logs)
$(ColorGreen '7)') $(ColorRed 'sudo required') remove vss.pipe.service
* logrotate *
$(ColorGreen '8)') $(ColorRed 'sudo required') activate logrotate on Valheim server logs
$(ColorGreen '9)') $(ColorRed 'sudo required') remove logrotate on server logs

** Service user **
$(ColorGreen '10)') setup the user who will execute service $(ColorRed 'prior') to services install, default is $USER

** Uninstall all **
$(ColorGreen '11)') $(ColorRed 'sudo required') remove all components (crontab, logrotate, valheim-server.service, vss.http.service)

$(ColorGreen '0)') quit
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
        read a
        case $a in
	        
			1) clear ; discord_menu ;;
			2) clear ; launcher_menu ;;
			3) clear ; http_status_menu ;;
			4) clear ; admin_menu ;;
			5) setup_value_prompt 'where are your logs (or where do you want it, file or dir, wildcards are valid) ?' 'VALHEIMSERVERLOGPATH' ; clear ; new_menu ;;
			6) set_service "$VSSPIPESERVICENAME"; sleep 2 ; clear ; new_menu ;;
			7) uninstall_service "$VSSPIPESERVICENAME" ; clear ; new_menu ;;
			8) set_logrotate ; sleep 5 ; clear ;  new_menu ;;
			9) sudo rm '/etc/logrotate.d/valheim' ; clear ; new_menu ;;
			10) setup_value_prompt 'whats the user you want to execute services ?' 'USERSERVICE' ; clear ; new_menu ;;
	     	11) replace_env_value 'CRONTABWEBHOOKFREQ' 0 ; set_cron ; sudo rm '/etc/logrotate.d/valheim' ; rm "$CWD/systemd/valheim.logrotate" ; uninstall_service "$VHSERVERSERVICENAME" ; uninstall_service "$VSSHTTPSERVICENAME" ; clear ; new_menu ;;
		
		0) exit 0 ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

# init new menu
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  clear ; new_menu
fi
