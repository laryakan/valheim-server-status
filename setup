#!/bin/bash
# author: laryakan, date 2021/03/12
# Basic env init
CWD="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"

function ensure_env_sync() {
  local env_file="${1:-${VSS_ENV_FILE:-}}"
  local template_file="${2:-$CWD/.env.server.dist}"
  local tmp_file
  local line
  local key

  if [ ! -f "$template_file" ]; then
    return
  fi
  if [ -z "$env_file" ] || [ ! -f "$env_file" ]; then
    echo "Cannot synchronize a missing configuration file: ${env_file:-unset}" >&2
    return 1
  fi

  tmp_file="$(mktemp)"
  cp "$env_file" "$tmp_file"

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|[[:space:]]*"#"*)
        continue
        ;;
      *=*)
        key="${line%%=*}"
        if ! grep -Fq "${key}=" "$tmp_file"; then
          awk -v new_line="$line" '
            BEGIN { inserted = 0 }
            {
              if (!inserted && $0 ~ /^set \+o allexport$/) {
                print new_line
                inserted = 1
              }
              print
            }
            END {
              if (!inserted) {
                print new_line
              }
            }
          ' "$tmp_file" > "$tmp_file.new" && mv "$tmp_file.new" "$tmp_file"
        fi
        ;;
    esac
  done < "$template_file"

  cp "$tmp_file" "$env_file"
  rm -f "$tmp_file"
}

function write_env_value() {
  local env_file="$1"
  local key="$2"
  local value="$3"
  local replacement
  local tmp_file

  printf -v replacement '%s=%q' "$key" "$value"
  tmp_file="$(mktemp)"
  if ! VSS_WRITE_ENV_KEY="$key" VSS_WRITE_ENV_REPLACEMENT="$replacement" awk '
    BEGIN {
      key = ENVIRON["VSS_WRITE_ENV_KEY"]
      replacement = ENVIRON["VSS_WRITE_ENV_REPLACEMENT"]
      updated = 0
    }
    index($0, key "=") == 1 && !updated {
      print replacement
      updated = 1
      next
    }
    { print }
    END {
      if (!updated) {
        print replacement
      }
    }
  ' "$env_file" > "$tmp_file"; then
    rm -f "$tmp_file"
    return 1
  fi
  if ! mv "$tmp_file" "$env_file"; then
    rm -f "$tmp_file"
    return 1
  fi
}

function list_server_profiles() {
  local profile
  for profile in "$CWD"/.env.*; do
    [ -f "$profile" ] || continue
    case "${profile##*/}" in
      .env.server.dist|.env.common.dist|.env.test) continue ;;
    esac
    printf '%s\n' "${profile##*.env.}"
  done
}

function setup_ui_read_menu_choice() {
  local maximum="$1"
  local selected_choice="${2:-1}"
  local key
  local sequence
  local input=''
  local index=0
  local selected
  local -a choices=()

  for ((index = 1; index <= maximum; index++)); do
    choices+=("$index")
  done
  choices+=(0)
  selected=0
  for index in "${!choices[@]}"; do
    if [ "${choices[$index]}" = "$selected_choice" ]; then
      selected="$index"
      break
    fi
  done

  if [ ! -t 0 ]; then
    read -r SETUP_UI_CHOICE || return 1
    return 0
  fi

  while IFS= read -r -s -n 1 key; do
    if [ "$key" = $'\x1b' ]; then
      sequence=''
      IFS= read -r -s -n 2 -t 0.1 sequence || true
      case "$sequence" in
        '[A')
          selected=$(( (selected + ${#choices[@]} - 1) % ${#choices[@]} ))
          ;;
        '[B')
          selected=$(( (selected + 1) % ${#choices[@]} ))
          ;;
        *)
          continue
          ;;
      esac
      SETUP_UI_SELECTED_CHOICE="${choices[$selected]}"
      SETUP_UI_CHOICE='__redraw__'
      return 0
    elif [ -z "$key" ] || [ "$key" = $'\n' ]; then
      if [ -n "$input" ]; then
        SETUP_UI_CHOICE="$input"
      else
        SETUP_UI_CHOICE="${choices[$selected]}"
      fi
      printf '\n'
      return 0
    elif [ "$key" = $'\177' ] || [ "$key" = $'\b' ]; then
      input="${input%?}"
      printf '\rTyped option: %s\033[K' "$input"
    else
      input+="$key"
      printf '\rTyped option: %s\033[K' "$input"
    fi
  done
  return 1
}

function setup_ui_menu_option() {
  local selected="$1"
  local option="$2"
  local label="$3"

  if [ "$selected" = "$option" ]; then
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
      printf '\033[7m  %2s  %s\033[0m\n' "$option" "$label"
    elif [ -t 1 ]; then
      printf '> %2s  %s\n' "$option" "$label"
    else
      printf '  %2s  %s\n' "$option" "$label"
    fi
  else
    printf '  %2s  %s\n' "$option" "$label"
  fi
}

function setup_ui_read_profile_choice() {
  local selected="${1:-0}"
  shift
  local -a profiles=("$@")
  local key
  local sequence
  local input=''

  if [ ! -t 0 ]; then
    printf 'Choice: '
    read -r SETUP_UI_CHOICE || return 1
    return 0
  fi

  printf 'Choice: '
  while IFS= read -r -s -n 1 key; do
    if [ "$key" = $'\x1b' ]; then
      sequence=''
      IFS= read -r -s -n 2 -t 0.1 sequence || true
      case "$sequence" in
        '[A')
          if [ "${#profiles[@]}" -gt 0 ]; then
            selected=$(( (selected + ${#profiles[@]} - 1) % ${#profiles[@]} ))
          fi
          ;;
        '[B')
          if [ "${#profiles[@]}" -gt 0 ]; then
            selected=$(( (selected + 1) % ${#profiles[@]} ))
          fi
          ;;
        *)
          continue
          ;;
      esac
      [ "${#profiles[@]}" -gt 0 ] || continue
      SETUP_UI_SELECTED_PROFILE_INDEX="$selected"
      SETUP_UI_CHOICE='__redraw__'
      return 0
    elif [ -z "$key" ] || [ "$key" = $'\n' ]; then
      if [ -n "$input" ]; then
        SETUP_UI_CHOICE="$input"
      elif [ "${#profiles[@]}" -gt 0 ]; then
        SETUP_UI_CHOICE="$((selected + 1))"
      else
        SETUP_UI_CHOICE=''
      fi
      printf '\n'
      return 0
    elif [ "$key" = $'\177' ] || [ "$key" = $'\b' ]; then
      input="${input%?}"
      printf '\rTyped choice: %s\033[K' "$input"
    else
      input+="$key"
      printf '\rTyped choice: %s\033[K' "$input"
    fi
  done
  return 1
}

function setup_ui_profile_option() {
  local selected="$1"
  local option="$2"
  local profile="$3"
  local current="$4"
  local marker=''
  [ "$current" != "$profile" ] || marker=' (current)'

  if [ "$selected" = "$option" ]; then
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
      printf '\033[7m  %2s  %s%s\033[0m\n' "$option" "$profile" "$marker"
    elif [ -t 1 ]; then
      printf '> %2s  %s%s\n' "$option" "$profile" "$marker"
    else
      printf '  %2s  %s%s\n' "$option" "$profile" "$marker"
    fi
  else
    printf '  %2s  %s%s\n' "$option" "$profile" "$marker"
  fi
}

function setup_ui_discord_webhook_state() {
  if [ -n "${WEBHOOKURL:-}" ] &&
     [ "${WEBHOOKURL:-}" != 'https://discord.com/api/webhooks/webhookId/webhookToken' ] &&
     [ "${WEBHOOKID:-}" != 'webhookId' ] &&
     [ "${WEBHOOKTOKEN:-}" != 'webhookToken' ] &&
     [ -n "${WEBHOOKID:-}" ] &&
     [ -n "${WEBHOOKTOKEN:-}" ]; then
    printf 'configured'
  else
    printf 'missing'
  fi
}

function setup_ui_discord_cron_state() {
  local profile="$1"
  local frequency="${CRONTABWEBHOOKFREQ:-}"
  local cron

  if [[ "$frequency" =~ ^[0-9]+$ ]] && (( 10#$frequency == 0 )); then
    printf 'disabled'
    return 0
  fi
  cron="$(crontab -l 2>/dev/null || true)"
  if printf '%s\n' "$cron" | grep -Fq "# vss-profile:$profile"; then
    printf 'scheduled'
  else
    printf 'missing'
  fi
}

function setup_ui_profile_webhook_message_id() {
  printf '%s' "${STATUSMESSAGEID:-${LASTLOGMESSAGEID:-${SERVERCONNECTIONINFOMESSAGEID:-}}}"
}

function setup_ui_profile_card() (
  local profile="$1"
  local current_marker=''
  local server_name
  local seed
  local bepinex
  local server_state
  local player_count
  local server_pid
  local webhook_state
  local cron_state
  local server_service_state
  local pipe_service_state
  local http_service_state
  local discord_message_state

  if ! vss_validate_server_name "$profile"; then
    printf '  +-- %s --+\n  | Invalid profile name\n  +----------+\n' "$profile"
    return 0
  fi
  VSS_SERVER_NAME="$profile"
  export VSS_SERVER_NAME
  unset VSS_ENV_FILE VSS_CONFIG_LOADED
  unset VHSERVERWORLD VHSERVERNAME VHSERVERSEED VHSERVERPORT VSSBEPINEXENABLED VALSERVERPID
  unset STATUSMESSAGEID LASTLOGMESSAGEID SERVERCONNECTIONINFOMESSAGEID
  source "$CWD/lib/config.sh" || {
    printf '  +-- %s --+\n  | Configuration unavailable\n  +----------------------+\n' "$profile"
    return 0
  }
  if ! vss_load_config "$CWD"; then
    printf '  +-- %s --+\n  | Configuration unavailable\n  +----------------------+\n' "$profile"
    return 0
  fi

  [ "$profile" != "${SETUP_UI_CURRENT_PROFILE:-}" ] || current_marker=' (current)'
  server_name="${VHSERVERNAME:-$VHSERVERWORLD}"
  seed="${VHSERVERSEED:-not set}"
  if [ "${VSSBEPINEXENABLED:-0}" = 1 ]; then
    bepinex='on'
  else
    bepinex='off'
  fi

  server_pid="$(vss_find_server_pid || true)"
  if [ -n "$server_pid" ]; then
    server_state='online'
  else
    server_state='offline'
  fi
  if [ "$server_state" = 'offline' ]; then
    player_count='0 connected'
  elif [ -r "$CONNECTEDPLAYERSFILE" ]; then
    player_count="$(awk -F';' 'NF >= 3 && $2 != "" { count++ } END { print count+0 }' "$CONNECTEDPLAYERSFILE")"
    if [ "$player_count" -eq 1 ]; then
      player_count='1 connected'
    else
      player_count="$player_count connected"
    fi
  else
    player_count='unknown'
  fi
  webhook_state="$(setup_ui_discord_webhook_state)"
  cron_state="$(setup_ui_discord_cron_state "$profile")"
  server_service_state="$(setup_ui_checkmark "$(setup_ui_unit_state "${VHSERVERSERVICENAME:-}")")"
  pipe_service_state="$(setup_ui_checkmark "$(setup_ui_unit_state "${VSSPIPESERVICENAME:-}")")"
  http_service_state="$(setup_ui_checkmark "$(setup_ui_unit_state "${VSSHTTPSERVICENAME:-}")")"
  if [ -n "$(setup_ui_profile_webhook_message_id)" ]; then
    discord_message_state='configured'
  else
    discord_message_state='missing'
  fi

  printf '  +-- %s%s --+\n' "$profile" "$current_marker"
  printf '  | Server: %s\n' "$server_name"
  printf '  | State: %s | Port: %s | BepInEx: %s | Seed: %s | Players: %s\n' \
    "$server_state" "${VHSERVERPORT:-unknown}" "$bepinex" "$seed" "$player_count"
  printf '  | Discord webhook: %s | Auto-update: %s\n' "$webhook_state" "$cron_state"
  printf '  | Setup: server%s HTTP%s pipe%s cron%s Discord%s\n' \
    "$server_service_state" "$http_service_state" "$pipe_service_state" \
    "$(setup_ui_checkmark "$cron_state")" \
    "$(setup_ui_checkmark "$discord_message_state")"
  printf '  +--------------------------------------------------+\n'
)

function setup_ui_profiles_overview() {
  local profile
  local profiles_found=0
  SETUP_UI_CURRENT_PROFILE="${VSS_SERVER_NAME:-}"
  export SETUP_UI_CURRENT_PROFILE
  printf '\nPROFILES OVERVIEW\n'
  while IFS= read -r profile; do
    [ -n "$profile" ] || continue
    profiles_found=1
    setup_ui_profile_card "$profile"
  done < <(list_server_profiles)
  if [ "$profiles_found" -eq 0 ]; then
    printf '  No server profiles found.\n'
  fi
  unset SETUP_UI_CURRENT_PROFILE
}

function read_profile_setting() (
  local name="$1"
  local key="$2"
  VSS_SERVER_NAME="$name"
  export VSS_SERVER_NAME
  unset VSS_ENV_FILE VSS_CONFIG_LOADED
  source "$CWD/lib/config.sh"
  vss_load_config "$CWD" || exit 1
  printf '%s' "${!key}"
)

function read_profile_common_setting() (
  local name="$1"
  local key="$2"
  VSS_SERVER_NAME="$name"
  export VSS_SERVER_NAME
  unset VSS_ENV_FILE VSS_CONFIG_LOADED
  source "$CWD/lib/config.sh"
  vss_load_config "$CWD" || exit 1
  if [ "$key" = "STEAMCMDPATH" ] && [ -z "${STEAMCMDPATH:-}" ]; then
    printf '%s' "${STEAMCMD:-}"
  else
    printf '%s' "${!key:-}"
  fi
)

function ensure_common_config() {
  local common_file="$CWD/.env"
  local profile
  local key
  local profile_value
  local candidate
  local index
  local -a common_keys=(
    STEAMCMDPATH VHSERVERDIR VHSERVERSAVEDIR USERSERVICE VALHEIMSERVERLOGDIR
    VSSLOGFILTER VSSERRFILTER VHSERVERLAUNCHER VSSHTTP VSSPIPE WEBHOOKUPDATE
    PUBLICIP WEBHOOKURL WEBHOOKID WEBHOOKTOKEN SENDLASTLOGS SENDSERVERCONNECTIONINFO
    CRONTABWEBHOOKFREQ EVENTREALTIME VSS_LANG
  )
  local -a common_values=()

  if [ ! -f "$CWD/.env.common.dist" ]; then
    echo "Shared configuration template not found: $CWD/.env.common.dist" >&2
    return 1
  fi
  if [ -f "$common_file" ]; then
    if ! vss_is_common_config "$common_file"; then
      echo "A legacy .env was found. Run ./migrate-v2-to-v3 before using setup." >&2
      return 1
    fi
    ensure_env_sync "$common_file" "$CWD/.env.common.dist"
    return $?
  fi
  for index in "${!common_keys[@]}"; do
    key="${common_keys[$index]}"
    candidate="${!key:-}"
    if [ "$key" = "STEAMCMDPATH" ] && [ -z "$candidate" ]; then
      candidate="${STEAMCMD:-}"
    fi
    for profile in $(list_server_profiles); do
      profile_value="$(read_profile_common_setting "$profile" "$key")" || return 1
      [ -n "$profile_value" ] || continue
      if [ -n "$candidate" ] && [ "$candidate" != "$profile_value" ]; then
        printf 'Shared setting %s differs between profiles; align it before creating the common .env.\n' "$key" >&2
        return 1
      fi
      candidate="$profile_value"
    done
    common_values[$index]="$candidate"
  done

  cp "$CWD/.env.common.dist" "$common_file" || return 1
  for index in "${!common_keys[@]}"; do
    key="${common_keys[$index]}"
    candidate="${common_values[$index]}"
    [ -n "$candidate" ] || continue
    write_env_value "$common_file" "$key" "$candidate" || return 1
  done
}

function validate_server_profile_ports() {
  local name="$1"
  local game_port="$2"
  local http_port="$3"
  local http_enabled="${4:-1}"
  local profile
  local configured_game
  local configured_http
  local game_start
  local http_value=0

  if ! [[ "$game_port" =~ ^[0-9]+$ ]]; then
    printf 'Server profile %s must use a numeric game port.\n' "$name" >&2
    return 1
  fi
  game_start=$((10#$game_port))
  if (( game_start < 1 || game_start > 65534 )); then
    printf 'Server profile %s has a game port outside the valid range.\n' "$name" >&2
    return 1
  fi
  if [ "$http_enabled" -eq 1 ]; then
    if ! [[ "$http_port" =~ ^[0-9]+$ ]]; then
      printf 'Server profile %s must use a numeric HTTP port.\n' "$name" >&2
      return 1
    fi
    http_value=$((10#$http_port))
    if (( http_value < 1 || http_value > 65535 )); then
      printf 'Server profile %s has an HTTP port outside the valid range.\n' "$name" >&2
      return 1
    fi
    if (( http_value >= game_start && http_value <= game_start + 1 )); then
      printf 'HTTP port %s overlaps the game port range %s-%s for %s.\n' \
        "$http_value" "$game_start" "$((game_start + 1))" "$name" >&2
      return 1
    fi
  fi

  while IFS= read -r profile; do
    [ -n "$profile" ] && [ "$profile" != "$name" ] || continue
    configured_game="$(read_profile_setting "$profile" VHSERVERPORT 2>/dev/null)" || continue
    configured_http="$(read_profile_setting "$profile" STATUSPORT 2>/dev/null)" || continue
    [[ "$configured_game" =~ ^[0-9]+$ && "$configured_http" =~ ^[0-9]+$ ]] || continue
    configured_game=$((10#$configured_game))
    configured_http=$((10#$configured_http))

    if (( game_start <= configured_game + 1 && configured_game <= game_start + 1 )); then
      printf 'Game port range %s-%s overlaps profile %s (%s-%s).\n' \
        "$game_start" "$((game_start + 1))" "$profile" \
        "$configured_game" "$((configured_game + 1))" >&2
      return 1
    fi
    if [ "$http_enabled" -eq 1 ]; then
      if (( http_value == configured_http )); then
        printf 'HTTP port %s is already used by profile %s.\n' "$http_value" "$profile" >&2
        return 1
      fi
      if (( http_value >= configured_game && http_value <= configured_game + 1 )); then
        printf 'HTTP port %s overlaps the game port range for profile %s.\n' "$http_value" "$profile" >&2
        return 1
      fi
    fi
    if (( configured_http >= game_start && configured_http <= game_start + 1 )); then
      printf 'Game port range %s-%s overlaps the HTTP port for profile %s (%s).\n' \
        "$game_start" "$((game_start + 1))" "$profile" "$configured_http" >&2
      return 1
    fi
  done < <(list_server_profiles)
  return 0
}

function ufw_rule_covers_port() {
  local rules="$1"
  local port="$2"
  local protocol="$3"

  printf '%s\n' "$rules" | awk -v port="$port" -v protocol="$protocol" '
    $1 == "To" && $2 == "Action" { in_rules = 1; next }
    !in_rules || $2 != "ALLOW" || $3 == "OUT" { next }
    {
      count = split($1, destination, "/")
      rule_protocol = (count > 1 ? destination[2] : "tcp")
      if (rule_protocol != protocol) {
        next
      }
      range_count = split(destination[1], range, ":")
      first = range[1] + 0
      last = (range_count > 1 ? range[2] + 0 : first)
      if (port >= first && port <= last) {
        found = 1
      }
    }
    END { exit(found ? 0 : 1) }
  '
}

function check_ufw_profile_rules() {
  local rules
  local port
  local protocol
  local missing=()
  local game_port
  local http_port
  local http_enabled="${1:-1}"

  if ! [[ "${VHSERVERPORT:-}" =~ ^[0-9]+$ ]] ||
     { [ "$http_enabled" -eq 1 ] && ! [[ "${STATUSPORT:-}" =~ ^[0-9]+$ ]]; }; then
    echo "Game port and active HTTP port must be numeric; UFW rule check skipped." >&2
    return 2
  fi
  game_port=$((10#$VHSERVERPORT))
  if (( game_port < 1 || game_port > 65534 )); then
    echo "Game port is outside the valid range; UFW rule check skipped." >&2
    return 2
  fi
  if [ "$http_enabled" -eq 1 ]; then
    http_port=$((10#$STATUSPORT))
    if (( http_port < 1 || http_port > 65535 )); then
      echo "HTTP port is outside the valid range; UFW rule check skipped." >&2
      return 2
    fi
  fi

  if ! command -v ufw >/dev/null 2>&1; then
    echo "UFW is not installed; firewall rule check skipped." >&2
    return 2
  fi
  if ! rules="$(sudo ufw status 2>&1)"; then
    echo "Could not read UFW status; firewall rule check skipped." >&2
    return 2
  fi
  if [[ "$rules" == *"Status: inactive"* ]]; then
    echo "UFW is inactive; configured ports are not being checked against rules." >&2
    return 1
  fi
  if [[ "$rules" != *"Status: active"* ]]; then
    echo "Could not determine whether UFW is active; firewall rule check skipped." >&2
    return 2
  fi

  for ((port = game_port; port <= game_port + 1; port++)); do
    for protocol in tcp udp; do
      if ! ufw_rule_covers_port "$rules" "$port" "$protocol"; then
        missing+=("$port/$protocol")
      fi
    done
  done
  if [ "$http_enabled" -eq 1 ] && ! ufw_rule_covers_port "$rules" "$http_port" tcp; then
    missing+=("$http_port/tcp")
  fi
  if [ "${#missing[@]}" -gt 0 ]; then
    printf 'Missing UFW ALLOW rules for %s: %s\n' "$VSS_SERVER_NAME" "${missing[*]}" >&2
    return 1
  fi

  if [ "$http_enabled" -eq 1 ]; then
    printf 'UFW ALLOW rules found for %s game ports %s-%s (TCP/UDP) and HTTP port %s/TCP.\n' \
      "$VSS_SERVER_NAME" "$game_port" "$((game_port + 1))" "$http_port"
  else
    printf 'UFW ALLOW rules found for %s game ports %s-%s (TCP/UDP); HTTP status is not installed.\n' \
      "$VSS_SERVER_NAME" "$game_port" "$((game_port + 1))"
  fi
}

function create_server_profile() {
  local name="$1"
  local env_file="$CWD/.env.$name"
  local args_file="$CWD/launcher/launcher-args.$name"
  local valheim_port=2456
  local status_port=8181

  if ! vss_validate_server_name "$name"; then
    echo "Invalid world name for a server profile: '$name'" >&2
    return 1
  fi
  if [ -e "$env_file" ]; then
    echo "Server profile already exists: $name" >&2
    return 1
  fi

  while ! validate_server_profile_ports "$name" "$valheim_port" "$status_port" >/dev/null 2>&1; do
    if (( valheim_port > 65532 || status_port >= 65535 )); then
      echo "No non-overlapping ports remain for server profile '$name'." >&2
      return 1
    fi
    valheim_port=$((valheim_port + 2))
    status_port=$((status_port + 1))
  done

  if ! cp "$CWD/.env.server.dist" "$env_file"; then
    printf 'Could not create profile configuration for %s.\n' "$name" >&2
    rm -f -- "$env_file" "$args_file" || printf 'Could not clean up incomplete profile files for %s.\n' "$name" >&2
    return 1
  fi
  if ! write_env_value "$env_file" VHSERVERWORLD "$name" ||
     ! write_env_value "$env_file" VHSERVERPORT "$valheim_port" ||
     ! write_env_value "$env_file" STATUSPORT "$status_port"; then
    printf 'Could not finish creating profile %s; removing the incomplete profile.\n' "$name" >&2
    rm -f -- "$env_file" "$args_file" || printf 'Could not clean up incomplete profile files for %s.\n' "$name" >&2
    return 1
  fi
  if ! cp "$CWD/examples/launcher-args" "$args_file"; then
    printf 'Could not create launcher arguments for profile %s; removing the incomplete profile.\n' "$name" >&2
    rm -f -- "$env_file" "$args_file" || printf 'Could not clean up incomplete profile files for %s.\n' "$name" >&2
    return 1
  fi
  VSS_SERVER_NAME="$name"
  VSS_ENV_FILE="$env_file"
  export VSS_SERVER_NAME VSS_ENV_FILE
  echo "Created server profile '$name' in $env_file" >&2
}

function load_server_profile_unchecked() {
  local name="$1"
  local http_enabled="${2:-}"
  if ! vss_validate_server_name "$name"; then
    echo "Invalid server profile name: '$name'" >&2
    return 1
  fi
  VSS_SERVER_NAME="$name"
  VSS_ENV_FILE="$CWD/.env.$name"
  VSS_CONFIG_LOADED=0
  export VSS_SERVER_NAME VSS_ENV_FILE VSS_CONFIG_LOADED
  source "$CWD/lib/config.sh"
  vss_load_config "$CWD" || return 1
  ensure_common_config || return 1
  VSS_CONFIG_LOADED=0
  vss_load_config "$CWD" || return 1
  ensure_env_sync "$VSS_ENV_FILE" "$CWD/.env.server.dist" || return 1
  VSS_CONFIG_LOADED=0
  vss_load_config "$CWD" || return 1
  if [ -z "$http_enabled" ]; then
    if [ -e "/etc/systemd/system/$VSSHTTPSERVICENAME" ] ||
       [ -L "/etc/systemd/system/$VSSHTTPSERVICENAME" ] ||
       [ -e "$CWD/systemd/$VSSHTTPSERVICENAME" ] ||
       [ -L "$CWD/systemd/$VSSHTTPSERVICENAME" ]; then
      http_enabled=1
    else
      http_enabled=0
    fi
  fi
  validate_server_profile_ports "$name" "$VHSERVERPORT" "$STATUSPORT" "$http_enabled" || return 1
  if [ ! -f "$VHSERVERLAUNCHERARGS" ]; then
    cp "$CWD/examples/launcher-args" "$VHSERVERLAUNCHERARGS" || return 1
  fi
}

function load_server_profile() {
  local requested_name="$1"
  local http_enabled="${2:-}"
  local previous_name="${VSS_SERVER_NAME:-}"
  local load_status
  VSS_PROFILE_RESTORE_FAILED=0

  if load_server_profile_unchecked "$requested_name" "$http_enabled"; then
    return 0
  else
    load_status=$?
  fi

  if [ -n "$previous_name" ] && ! load_server_profile_unchecked "$previous_name"; then
    printf 'Failed to restore the previously active profile %s after loading %s failed.\n' \
      "$previous_name" "$requested_name" >&2
    VSS_PROFILE_RESTORE_FAILED=1
    return 1
  fi
  return "$load_status"
}

function select_server_profile() {
  local profile
  local choice
  local profile_index
  local selected_profile_index=0
  local selection_initialized=0
  local notice=""
  local -a profiles=()
  while true; do
    profiles=()
    while IFS= read -r profile; do
      [ -n "$profile" ] && profiles+=("$profile")
    done < <(list_server_profiles)
    if [ "$selection_initialized" -eq 0 ]; then
      for profile_index in "${!profiles[@]}"; do
        if [ "${profiles[$profile_index]}" = "${VSS_SERVER_NAME:-}" ]; then
          selected_profile_index="$profile_index"
          break
        fi
      done
      selection_initialized=1
    fi

    setup_ui_header "Select a server"
    if [ -n "$notice" ]; then
      printf '\n%s\n' "$notice"
      notice=""
    fi
    setup_ui_profiles_overview
    printf '\nUse the arrows or enter a profile number/name; n creates a profile, q quits.\n\n'
    if [ "${#profiles[@]}" -eq 0 ]; then
      printf '  No server profiles found yet.\n\n'
    else
      for profile_index in "${!profiles[@]}"; do
        profile="${profiles[$profile_index]}"
        setup_ui_profile_option "$((selected_profile_index + 1))" "$((profile_index + 1))" \
          "$profile" "${VSS_SERVER_NAME:-}"
      done
      printf '\n'
    fi
    printf '  n  Create a profile\n'
    printf '  q  Quit setup\n\n'
    printf 'Which server profile do you want to select?\n'
    setup_ui_read_profile_choice "$selected_profile_index" "${profiles[@]}" || return 1
    choice="$SETUP_UI_CHOICE"
    if [ "$choice" = '__redraw__' ]; then
      selected_profile_index="$SETUP_UI_SELECTED_PROFILE_INDEX"
      continue
    fi
    case "$choice" in
      n|N)
        printf 'World name: '
        read -r profile || return 1
        if ! vss_validate_server_name "$profile"; then
          notice="Invalid world name. Use letters, numbers, dots, underscores, and hyphens."
        elif [ -e "$CWD/.env.$profile" ]; then
          notice="A profile named '$profile' already exists."
        elif create_server_profile "$profile"; then
          SELECTED_SERVER_PROFILE="$profile"
          return 0
        else
          notice="Could not create '$profile'. Review the error above and check directory permissions."
        fi
        ;;
      q|Q) return 1 ;;
      *)
        if [[ "$choice" =~ ^[0-9]+$ ]] &&
           (( choice >= 1 && choice <= ${#profiles[@]} )); then
          SELECTED_SERVER_PROFILE="${profiles[$((choice - 1))]}"
          return 0
        elif [ -f "$CWD/.env.$choice" ]; then
          SELECTED_SERVER_PROFILE="$choice"
          return 0
        fi
        notice="No profile matches '$choice'. Choose a listed number/name, n, or q."
        ;;
    esac
  done
}

source "$CWD/lib/config.sh"

# VSS Setup menu
# Colors
red='\e[31m'
green='\e[32m'
blue='\e[94m'
cyan='\e[36m'
yellow='\e[93m'
magenta='\e[35m'
clear='\e[0m'
ColorRed(){
	if [ -n "${NO_COLOR:-}" ]; then printf '%s' "$1"; else printf '%b%s%b' "$red" "$1" "$clear"; fi
}
ColorGreen(){
	if [ -n "${NO_COLOR:-}" ]; then printf '%s' "$1"; else printf '%b%s%b' "$green" "$1" "$clear"; fi
}
ColorBlue(){
	if [ -n "${NO_COLOR:-}" ]; then printf '%s' "$1"; else printf '%b%s%b' "$blue" "$1" "$clear"; fi
}
ColorCyan(){
	if [ -n "${NO_COLOR:-}" ]; then printf '%s' "$1"; else printf '%b%s%b' "$cyan" "$1" "$clear"; fi
}
ColorYellow(){
	if [ -n "${NO_COLOR:-}" ]; then printf '%s' "$1"; else printf '%b%s%b' "$yellow" "$1" "$clear"; fi
}
ColorMagenta(){
	if [ -n "${NO_COLOR:-}" ]; then printf '%s' "$1"; else printf '%b%s%b' "$magenta" "$1" "$clear"; fi
}

function setup_ui_color() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    printf '\033[%sm' "$1"
  fi
}

function setup_ui_reset_color() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    printf '\033[0m'
  fi
}

function setup_ui_clear() {
  [ -t 1 ] || return 0
  [ -n "${TERM:-}" ] || return 0
  [ -z "${VSS_SETUP_NO_CLEAR:-}" ] || return 0
  command -v clear >/dev/null 2>&1 && command clear
}

function setup_ui_header() {
  local section="$1"
  setup_ui_clear
  printf '\n'
  setup_ui_color '1;36'
  printf 'VALHEIM SERVER STATUS\n'
  setup_ui_reset_color
  printf 'Multi-server control panel'
  [ -z "$section" ] || printf '  /  %s' "$section"
  printf '\n'
  printf '%s\n' '------------------------------------------------------------'
}

function setup_ui_unit_state() {
  if [ -e "/etc/systemd/system/$1" ]; then
    printf 'installed'
  else
    printf 'not installed'
  fi
}

function setup_ui_checkmark() {
  case "$1" in
    installed|scheduled|configured) printf '[x]' ;;
    *) printf '[ ]' ;;
  esac
}

function setup_ui_dashboard() {
  local server_pid
  local server_state="offline"
  local webhook_state
  local cron_state

  server_pid="$(vss_find_server_pid || true)"
  if [ -n "$server_pid" ] && ps -p "$server_pid" >/dev/null 2>&1; then
    server_state="running (PID $server_pid)"
  fi

  setup_ui_color '1'
  printf '\nProfile: %s\n' "${VSS_SERVER_NAME:-none selected}"
  setup_ui_reset_color
  printf 'World: %s  |  Valheim: %s\n' "${VHSERVERWORLD:-not configured}" "$server_state"
  printf 'Ports: game %s  |  HTTP %s\n' "${VHSERVERPORT:-unknown}" "${STATUSPORT:-unknown}"
  printf 'Services: server %s  |  standalone pipe %s  |  HTTP %s\n' \
    "$(setup_ui_unit_state "${VHSERVERSERVICENAME:-}")" \
    "$(setup_ui_unit_state "${VSSPIPESERVICENAME:-}")" \
    "$(setup_ui_unit_state "${VSSHTTPSERVICENAME:-}")"
  webhook_state="$(setup_ui_discord_webhook_state)"
  cron_state="$(setup_ui_discord_cron_state "${VSS_SERVER_NAME:-}")"
  printf 'Discord webhook: %s  |  Automatic update: %s\n' "$webhook_state" "$cron_state"
  printf '%s\n' '------------------------------------------------------------'
}

# get the setup status
# Setup service with conf values
function setup_status(){
	echo -ne "
======== VSS setup completion =========
Active server profile: $VSS_SERVER_NAME
"
LIVE_VALHEIM_PID="$(vss_find_server_pid || true)"
if [ -n "$LIVE_VALHEIM_PID" ] && ps -p "$LIVE_VALHEIM_PID" >/dev/null 2>&1; then echo -e "Valheim Server $(ColorGreen online)"; else echo -e "Valheim Server $(ColorRed offline)"; fi
if [ ! -z $(pgrep $(basename $VSSLOGFILTER)) ];then echo -e "VSS log filter $(ColorGreen running)";else echo -e "VSS log filter $(ColorRed stopped) or $(ColorRed 'not piped!')";fi
if [ "$VHSERVERWORLD" != 'server.world' ];then echo -e "Custom launcher world $(ColorGreen 'is set')";else echo -e "Custom launcher world $(ColorRed 'has default value')";fi
if [ -e '/etc/logrotate.d/valheim-vss' ];then echo -e "shared logrotate $(ColorGreen set)";else echo -e "shared logrotate $(ColorRed 'not set')";fi
if [ "$(setup_ui_discord_webhook_state)" = 'configured' ];then echo -e "$(ColorMagenta 'Discord') webhook $(ColorGreen 'configured locally')";else echo -e "$(ColorMagenta 'Discord') webhook $(ColorRed 'not configured')";fi
if [ -n "$(setup_ui_profile_webhook_message_id)" ];then echo -e "$(ColorMagenta 'Discord') webhook $(ColorGreen 'can update its message')";else echo -e "$(ColorMagenta 'Discord') webhook $(ColorRed 'will create its message')";fi
if [ "$SENDLASTLOGS" -gt 0 ];then echo -e "$(ColorMagenta 'Discord') webhook $(ColorGreen 'will send logs')";else echo -e "$(ColorMagenta 'Discord') webhook $(ColorYellow 'will not send log')";fi
if [ "$SENDSERVERCONNECTIONINFO" -gt 0 ];then echo -e "$(ColorMagenta 'Discord') webhook $(ColorGreen 'will send connection info')";else echo -e "$(ColorMagenta 'Discord') webhook $(ColorYellow 'will not send connection info')";fi
case "$(setup_ui_discord_cron_state "$VSS_SERVER_NAME")" in
  scheduled) echo -e "Webhook crontab $(ColorGreen 'is scheduled')" ;;
  disabled) echo -e "Webhook crontab $(ColorYellow 'is disabled')" ;;
  *) echo -e "Webhook crontab $(ColorRed 'is missing')" ;;
esac
if [ -e "/etc/systemd/system/$VHSERVERSERVICENAME" ];then echo -e "$VHSERVERSERVICENAME (valheim server) is $(ColorGreen 'present') in system";else echo -e  "$VHSERVERSERVICENAME (valheim server) is $(ColorRed 'missing') in system";fi
if [ -e "/etc/systemd/system/$VSSHTTPSERVICENAME" ];then echo -e "$VSSHTTPSERVICENAME (vss over http) is $(ColorGreen 'present') in system";else echo -e  "$VSSHTTPSERVICENAME (vss over http) is $(ColorRed 'missing') in system";fi
if [ -e "/etc/systemd/system/$VSSPIPESERVICENAME" ];then echo -e "$VSSPIPESERVICENAME is $(ColorGreen 'present') in system (captures BepInEx or externally redirected logs)";else echo -e  "$VSSPIPESERVICENAME is $(ColorRed 'missing') in system (installed automatically for BepInEx or external logs)";fi
if [ "${VSSBEPINEXENABLED:-0}" -eq 1 ];then echo -e "BepInEx packaged version $(ColorGreen 'activated') on VSS server";else echo -e  "BepInEx packaged version is $(ColorRed 'deactivated') on VSS server";fi
echo ""
echo "--Ports--"
echo -e "Please, run \e[1msudo ufw status\e[0m (firewall) to see if these ports are open:"
echo -e "- $VHSERVERPORT to $(($VHSERVERPORT+1))/tcp/udp (Valheim server)"
echo -e "- $STATUSPORT/tcp (VSS over HTTP)"
echo "======================================="
}

source "$CWD/lib/validation.sh"

function default_integer_value() {
  case "$1" in
    VHSERVERPORT) echo 2456 ;;
    STATUSPORT) echo 8181 ;;
    SENDLASTLOGS) echo 0 ;;
    SENDSERVERCONNECTIONINFO) echo 0 ;;
    CRONTABWEBHOOKFREQ) echo 5 ;;
    EVENTREALTIME) echo 0 ;;
    *) echo 0 ;;
  esac
}

function reload_profile_config() {
  VSS_CONFIG_LOADED=0
  vss_load_config "$CWD"
}

function is_common_setting() {
  case "$1" in
    VSSDIR|STEAMCMDPATH|VHSERVERDIR|VHSERVERSAVEDIR|USERSERVICE|VALHEIMSERVERLOGDIR|\
    VSSLOGFILTER|VSSERRFILTER|PUBLICIP|VHSERVERLAUNCHER|VHSERVERLAUNCHERDIR|\
    VSSHTTP|VSSHTTPDIR|VSSPIPE|VSSPIPEDIR|WEBHOOKUPDATE|WEBHOOKURL|WEBHOOKID|\
    WEBHOOKTOKEN|SENDLASTLOGS|SENDSERVERCONNECTIONINFO|CRONTABWEBHOOKFREQ|\
    EVENTREALTIME|VSS_LANG)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# env conf value changing function
function replace_env_value() {
  local key="$1"
  local value="${2:-}"
  local env_file="$VSS_ENV_FILE"
  local candidate_game_port="${VHSERVERPORT:-}"
  local candidate_http_port="${STATUSPORT:-}"

  if [ "$key" = "VHSERVERWORLD" ]; then
    echo "The world name identifies this profile. Use the profile rename operation instead." >&2
    return 1
  fi

  if [ "$key" = "R2MODMANCODE" ] && [ -n "$value" ] && ! validate_r2modman_code "$value"; then
    echo "R2MODMANCODE must be a UUID such as 01a1eaf3-9be3-9083-b9b4-26768368368e." >&2
    return 1
  fi

  case "$key" in
    STATUSMESSAGEID|LASTLOGMESSAGEID|SERVERCONNECTIONINFOMESSAGEID)
      if [ -n "$value" ]; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$VSS_ENV_FILE"
      else
        sed -i "s|^${key}=.*|${key}=''|" "$VSS_ENV_FILE"
      fi
      reload_profile_config
      return
      ;;
  esac

  if ! validate_env_integer "$key" "$value"; then
    local fallback
    fallback="$(default_integer_value "$key")"
    echo "Invalid integer value for $key: '$value'; using default $fallback" >&2
    value="$fallback"
  fi

  case "$key" in
    VHSERVERPORT) candidate_game_port="$value" ;;
    STATUSPORT) candidate_http_port="$value" ;;
  esac
  if [[ "$key" = VHSERVERPORT || "$key" = STATUSPORT ]]; then
    validate_server_profile_ports "$VSS_SERVER_NAME" "$candidate_game_port" "$candidate_http_port" || return 1
  fi

  if is_common_setting "$key"; then
    ensure_common_config || return 1
    env_file="$CWD/.env"
    [ -f "$env_file" ] || {
      echo "Configuration file not found: $env_file" >&2
      return 1
    }
    write_env_value "$env_file" "$key" "$value" || return 1
  fi
  if [ "$env_file" = "$VSS_ENV_FILE" ]; then
    if [[ "$value" == *[!0-9]* ]] && [[ "$value" != "" ]]; then
      sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$VSS_ENV_FILE"
    else
      sed -i "s|^${key}=.*|${key}=${value}|" "$VSS_ENV_FILE"
    fi
  fi

  reload_profile_config || return 1
}

# param1=value_label, param2=value_variable_in_.env
function setup_value_prompt() {
  local is_secret=0
  local new_value
  echo ""
  echo "**$1**"
  case "$2" in
    WEBHOOKURL|WEBHOOKTOKEN|VHSERVERPASSWD)
      is_secret=1
      if [ -n "${!2:-}" ]; then
        printf 'current value: configured (hidden)\n'
      else
        printf 'current value: not configured\n'
      fi
      ;;
    *)
      printf 'current value: %s\n' "${!2}"
      ;;
  esac
  if [ "$is_secret" -eq 1 ] && [ -t 0 ]; then
    read -r -s -p "enter new value ('n' to leave unchanged): " new_value || return 1
    printf '\n'
  else
    printf "enter new value ('n' to leave unchanged): "
    read -r new_value || return 1
  fi
  if [ "$new_value" = 'n' ]; then
    echo "value unchanged"
    return 0
  fi
  if ! replace_env_value "$2" "$new_value"; then
    echo "value unchanged" >&2
    return 1
  fi
  if [ "$is_secret" -eq 1 ]; then
    echo "new value set (hidden)"
  else
    echo "new value set: ${!2}"
  fi
  echo ""
}

function setup_menu_render() {
  local section="$1"
  local notice="${2:-}"
  setup_ui_header "$section"
  setup_ui_dashboard
  if [ -n "$notice" ]; then
    printf '\n%s\n' "$notice"
  fi
}

function setup_ui_pause() {
  local ignored
  if [ -t 0 ]; then
    read -r -p "Press Enter to continue..." ignored || true
  fi
}

# trying autoconfig
function auto_conf(){
	# Searching for Valheim server dir
	# Searching for running Valheim server to complete
	VHSERVERPROCESS=$(ps -auxwe|grep -v grep|grep valheim_server)
	# if process found
	if [ ! -z "$VHSERVERPROCESS" ]
	then
		FVHSERVERWORLD=$(echo $VHSERVERPROCESS|sed -n -e 's/^.*-world //p'|cut -d' ' -f1)
		if [ "$FVHSERVERWORLD" != "$VSS_SERVER_NAME" ]; then
			echo "Running server world '$FVHSERVERWORLD' does not match selected profile '$VSS_SERVER_NAME'; no settings were changed." >&2
			return 1
		fi
		# get the user who will execute services
		FUSERSERVICE=$(echo $VHSERVERPROCESS|cut -d' ' -f1)
		replace_env_value 'USERSERVICE' "$FUSERSERVICE"
		# get path
		FVHSERVERDIR=$(echo $VHSERVERPROCESS|sed -n -e 's/^.*PWD=//p'|cut -d' ' -f1)
		replace_env_value 'VHSERVERDIR' "$FVHSERVERDIR"
		# get Valheim server port
		FVHSERVERPORT=$(echo $VHSERVERPROCESS|sed -n -e 's/^.*-port //p'|cut -d' ' -f1)
		replace_env_value 'VHSERVERPORT' $FVHSERVERPORT
		# get Your server name
		FVHSERVERNAME=$(echo $VHSERVERPROCESS|sed -n -e 's/^.*-name //p'|cut -d' ' -f1)
		replace_env_value 'VHSERVERNAME' "$FVHSERVERNAME"
		# get you server world name
		# get world seed if present
		FVHSERVERSEED=$(echo $VHSERVERPROCESS|sed -n -e 's/^.*-world_seed //p'|cut -d' ' -f1)
		if [ ! -z "$FVHSERVERSEED" ]; then
			replace_env_value 'VHSERVERSEED' "$FVHSERVERSEED"
		fi
		# get save dir if present
		FVHSERVERSAVEDIR=$(echo $VHSERVERPROCESS|sed -n -e 's/^.*-savedir //p'|cut -d' ' -f1)
		if [ ! -z "$FVHSERVERSAVEDIR" ]; then
			replace_env_value 'VHSERVERSAVEDIR' "$FVHSERVERSAVEDIR"
		fi
		# get crossplay if present
		FVHSERVERCROSSPLAY=$(echo $VHSERVERPROCESS|grep -o -- '-crossplay' | head -n 1)
		if [ -n "$FVHSERVERCROSSPLAY" ]; then
			replace_env_value 'VHSERVERCROSSPLAY' 1
		else
			replace_env_value 'VHSERVERCROSSPLAY' 0
		fi
		# get Your server password
		FVHSERVERPASSWD=$(echo $VHSERVERPROCESS|sed -n -e 's/^.*-password //p'|cut -d' ' -f1)
		replace_env_value 'VHSERVERPASSWD' "$FVHSERVERPASSWD"

		echo -ne "
		$(ColorGreen 'auto-conf done, please stop your Valheim server now.') 
		$(ColorGreen 'If you ve set a service, delete it before using our.')
		"
	fi
}

# Setup cron
function set_cron() {
	local profile
	local marker
	local current_cron
	local updated_cron
	current_cron="$(crontab -l 2>/dev/null || true)"
	updated_cron="$current_cron"
	for profile in $(list_server_profiles); do
	  marker="# vss-profile:$profile"
	  updated_cron="$(printf '%s\n' "$updated_cron" | grep -Fv "$marker" || true)"
	  if [ "${CRONTABWEBHOOKFREQ:-0}" -gt 0 ]; then
	    updated_cron="$(printf '%s\n%s\n' "$updated_cron" "*/$CRONTABWEBHOOKFREQ * * * * VSS_SERVER_NAME=$profile $WEBHOOKUPDATE $marker")"
	  fi
	done
	if ! printf '%s\n' "$updated_cron" | crontab -; then
	  echo "Could not update the per-profile Discord cron jobs." >&2
	  return 1
	fi
	echo "$(ColorGreen 'crontab updated, you can check it with \*crontab -l\*, edit with \*crontab -e\*')"
}

function remove_profile_cron() {
  local profile="$1"
  local marker="# vss-profile:$profile"
  local current_cron
  local updated_cron
  current_cron="$(crontab -l 2>/dev/null || true)"
  updated_cron="$(printf '%s\n' "$current_cron" | grep -Fv "$marker" || true)"
  if ! printf '%s\n' "$updated_cron" | crontab -; then
    printf 'Could not remove the cron job for profile %s.\n' "$profile" >&2
    return 1
  fi
}

function set_maintenance_cron() {
  local script_command
  local marker="# vss-maintenance"
  local entry
  local current_cron
  local updated_cron

  printf -v script_command '%q' "$CWD/vss.maintenance"
  entry="0 5 * * * $script_command $marker"
  current_cron="$(sudo crontab -l 2>/dev/null || true)"
  updated_cron="$(printf '%s\n' "$current_cron" |
    grep -Fv "$marker" |
    grep -Fv "$CWD/vss.maintenance" || true)"
  if ! printf '%s\n%s\n' "$updated_cron" "$entry" | sudo crontab -; then
    echo "Could not install the global maintenance schedule in root's crontab." >&2
    return 1
  fi
  echo "Global maintenance is scheduled daily at 05:00 local time in root's crontab."
  echo "Remove any older manual vss.maintenance cron entry to avoid running it twice."
}

function remove_maintenance_cron() {
  local marker="# vss-maintenance"
  local current_cron
  local updated_cron

  current_cron="$(sudo crontab -l 2>/dev/null || true)"
  updated_cron="$(printf '%s\n' "$current_cron" |
    grep -Fv "$marker" |
    grep -Fv "$CWD/vss.maintenance" || true)"
  if ! printf '%s\n' "$updated_cron" | sudo crontab -; then
    echo "Could not remove the global maintenance schedule from root's crontab." >&2
    return 1
  fi
  echo "Global maintenance schedule removed from root's crontab."
}

function restart_maintenance_services() {
  local unit
  local failed=0
  for unit in "$@"; do
    printf 'Starting previously active service %s\n' "$unit"
    if ! sudo systemctl start "$unit"; then
      printf 'Failed to restart %s.\n' "$unit" >&2
      failed=1
    fi
  done
  return "$failed"
}

function run_server_maintenance() {
  local profile
  local unit
  local update_status=0
  local restart_status=0
  local -a profiles=()
  local -a installed_units=()
  local -a active_units=()

  while IFS= read -r profile; do
    [ -n "$profile" ] && profiles+=("$profile")
  done < <(list_server_profiles)
  if [ "${#profiles[@]}" -eq 0 ]; then
    echo "No server profiles are configured; maintenance was not run." >&2
    return 1
  fi
  if [ -z "${VHSERVERDIR:-}" ] || [ ! -d "$VHSERVERDIR" ]; then
    echo "The shared Valheim server directory is missing or invalid; maintenance was not run." >&2
    return 1
  fi
  if [ -z "${STEAMCMDPATH:-}" ] || [ ! -x "$STEAMCMDPATH" ]; then
    echo "STEAMCMDPATH is missing or is not executable; maintenance was not run." >&2
    return 1
  fi
  if [ -z "${USERSERVICE:-}" ]; then
    echo "USERSERVICE is empty; maintenance was not run." >&2
    return 1
  fi

  for profile in "${profiles[@]}"; do
    unit="valheim-server.$profile.service"
    if sudo systemctl cat "$unit" >/dev/null 2>&1; then
      installed_units+=("$unit")
      if sudo systemctl is-active --quiet "$unit"; then
        active_units+=("$unit")
      fi
    fi
  done
  if [ "${#installed_units[@]}" -eq 0 ]; then
    echo "No installed Valheim server services were found; maintenance was not run." >&2
    return 1
  fi

  printf 'Stopping all %s installed Valheim server instance(s) before updating the shared server files.\n' \
    "${#installed_units[@]}"
  for unit in "${installed_units[@]}"; do
    if ! sudo systemctl stop "$unit"; then
      printf 'Failed to stop %s; restoring services that were active before maintenance.\n' "$unit" >&2
      restart_maintenance_services "${active_units[@]}" || true
      return 1
    fi
  done

  printf 'Updating Valheim server files in %s with SteamCMD.\n' "$VHSERVERDIR"
  if ! sudo -u "$USERSERVICE" "$STEAMCMDPATH" +force_install_dir "$VHSERVERDIR" \
      +login anonymous +app_update 896660 validate +exit; then
    echo "SteamCMD update failed." >&2
    update_status=1
  fi

  if ! restart_maintenance_services "${active_units[@]}"; then
    restart_status=1
  fi
  if [ "$update_status" -ne 0 ] || [ "$restart_status" -ne 0 ]; then
    echo "Maintenance completed with errors; inspect SteamCMD and systemd service status." >&2
    return 1
  fi
  echo "Valheim maintenance completed; only previously active instances were restarted."
}

# Render a profile-specific unit from the shared service examples.
function render_service() {
	local SERVICENAME="$1"
	local TEMPLATE
	case "$SERVICENAME" in
	  valheim-server.*.service) TEMPLATE="valheim-server.service" ;;
	  vss.http.*.service) TEMPLATE="vss.http.service" ;;
	  vss.pipe.*.service) TEMPLATE="vss.pipe.service" ;;
	  *) echo "Unsupported service template: $SERVICENAME" >&2; return 1 ;;
	esac
	mkdir -p "$CWD/systemd"
	rm -f "$CWD/systemd/$SERVICENAME"
	cp "$CWD/examples/$TEMPLATE" "$CWD/systemd/$SERVICENAME" || return 1

	# steam real exec user
	sed -i "s[###EXECUSER###[$USERSERVICE[g" "$CWD/systemd/$SERVICENAME"
	sed -i "s[###VSSSERVERNAME###[$VSS_SERVER_NAME[g" "$CWD/systemd/$SERVICENAME"

	if [ "$SERVICENAME" = "$VHSERVERSERVICENAME" ]
	then
	# set steamcmd path for server update
	sed -i "s[###STEAMCMDPATH###[$STEAMCMDPATH[g" "$CWD/systemd/$SERVICENAME"
	# important : set launcher path
	sed -i "s[###VHSERVERLAUNCHER###[$VHSERVERLAUNCHER[g" "$CWD/systemd/$SERVICENAME"
	# important : set launcher dir
	sed -i "s[###VHSERVERLAUNCHERDIR###[$VHSERVERLAUNCHERDIR[g" "$CWD/systemd/$SERVICENAME"
	# important : set server dir
	sed -i "s[###VHSERVERDIR###[$VHSERVERDIR[g" "$CWD/systemd/$SERVICENAME"
	fi

	if [ "$SERVICENAME" = "$VSSHTTPSERVICENAME" ]
	then
	# set steamcmd path for server update
	sed -i "s[###VSSHTTP###[$VSSHTTP[g" "$CWD/systemd/$SERVICENAME"
	# set valheim server dir for server update
	sed -i "s[###VSSHTTPDIR###[$VSSHTTPDIR[g" "$CWD/systemd/$SERVICENAME"
	fi

	if [ "$SERVICENAME" = "$VSSPIPESERVICENAME" ]
	then
	# set steamcmd path for server update
	sed -i "s[###VSSPIPE###[$VSSPIPE[g" "$CWD/systemd/$SERVICENAME"
	# set valheim server dir for server update
	sed -i "s[###VSSPIPEDIR###[$VSSPIPEDIR[g" "$CWD/systemd/$SERVICENAME"
	fi
	if grep -q '###.*###' "$CWD/systemd/$SERVICENAME"; then
		echo "Unresolved placeholder in generated service $SERVICENAME" >&2
		return 1
	fi
	return 0
}

# Setup service with profile-specific conf values.
function set_service(){
	local SERVICENAME="$1"
	if [ "$SERVICENAME" = "$VSSHTTPSERVICENAME" ]; then
		validate_server_profile_ports "$VSS_SERVER_NAME" "$VHSERVERPORT" "$STATUSPORT" 1 || return 1
	fi
	render_service "$SERVICENAME" || return 1
	# copying to system
	if ! sudo ln -sfn "$CWD/systemd/$SERVICENAME" "/etc/systemd/system/$SERVICENAME"; then
		echo -e "$(ColorRed 'Since sudo has failed, here s the command we tried : ')" >&2
		echo -e "sudo ln -sfn \"$CWD/systemd/$SERVICENAME\" \"/etc/systemd/system/$SERVICENAME\"" >&2
		echo -e "sudo systemctl daemon-reload" >&2
		echo -e "sudo systemctl enable $SERVICENAME" >&2
		echo -e "sudo systemctl start $SERVICENAME" >&2
		return 1
	fi

	sudo systemctl daemon-reload || return 1
	sudo systemctl enable "$SERVICENAME" || return 1
	sudo systemctl start "$SERVICENAME" || return 1
	echo -e "$(ColorGreen 'service set and started')"
	echo -e "if the service is set, you can auto-start after reboot using \"systemctl enable $SERVICENAME\""
}

function uninstall_service(){
  local service_name="$1"
  local systemd_dir="${2:-/etc/systemd/system}"
  local unit_file="$systemd_dir/$service_name"
  local unit_managed=0

  if [[ -e "$unit_file" || -L "$unit_file" ]] ||
     systemctl is-active --quiet "$service_name" ||
     systemctl is-enabled --quiet "$service_name"; then
    unit_managed=1
  fi

  if systemctl is-active --quiet "$service_name"; then
    if ! sudo systemctl stop "$service_name"; then
      printf 'Failed to stop service %s; its unit files were kept.\n' "$service_name" >&2
      return 1
    fi
    if systemctl is-active --quiet "$service_name"; then
      printf 'Service %s is still active; its unit files were kept.\n' "$service_name" >&2
      return 1
    fi
  fi

  if [[ "$unit_managed" -eq 1 ]]; then
    if ! sudo systemctl disable "$service_name"; then
      printf 'Failed to disable service %s; its unit files were kept.\n' "$service_name" >&2
      return 1
    fi
    if ! sudo systemctl reset-failed "$service_name"; then
      printf 'Failed to reset service state for %s; its unit files were kept.\n' "$service_name" >&2
      return 1
    fi
    if [[ -e "$unit_file" || -L "$unit_file" ]]; then
      if ! sudo rm -f -- "$unit_file"; then
        printf 'Failed to remove systemd unit file %s.\n' "$unit_file" >&2
        return 1
      fi
    fi
    if ! sudo systemctl daemon-reload; then
      printf 'Failed to reload systemd after removing %s.\n' "$service_name" >&2
      return 1
    fi
  fi

  if ! rm -f -- "$CWD/systemd/$service_name"; then
    printf 'Failed to remove generated unit file for %s.\n' "$service_name" >&2
    return 1
  fi
  printf 'Service removed: %s\n' "$service_name"
}

function stop_valheim_service(){
  if [ ! -e "/etc/systemd/system/$VHSERVERSERVICENAME" ]; then
    echo "Valheim service does not exist: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  if ! systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    echo "Valheim service is not running: $VHSERVERSERVICENAME"
    return 0
  fi
  if ! sudo systemctl stop "$VHSERVERSERVICENAME"; then
    echo "Failed to stop Valheim service: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  if systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    echo "Valheim service is still active after stop returned: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  echo "Valheim service stopped: $VHSERVERSERVICENAME"
}

function start_valheim_service(){
  if [ ! -e "/etc/systemd/system/$VHSERVERSERVICENAME" ]; then
    echo "Valheim service does not exist: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  if systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    echo "Valheim service is already running: $VHSERVERSERVICENAME"
    return 0
  fi
  if ! sudo systemctl start "$VHSERVERSERVICENAME"; then
    echo "Failed to start Valheim service: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  if ! systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    echo "Valheim service did not remain active after start: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  echo "Valheim service started: $VHSERVERSERVICENAME"
}

function restart_valheim_service(){
  if [ ! -e "/etc/systemd/system/$VHSERVERSERVICENAME" ]; then
    echo "Valheim service does not exist: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  if ! sudo systemctl restart "$VHSERVERSERVICENAME"; then
    echo "Failed to restart Valheim service: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  if ! systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    echo "Valheim service did not remain active after restart: $VHSERVERSERVICENAME" >&2
    return 1
  fi
  echo "Valheim service restarted: $VHSERVERSERVICENAME"
}

function status_valheim_service(){
  systemctl status --no-pager "$VHSERVERSERVICENAME"
}

function restart_vsspipe_service(){
  if [ -e "/etc/systemd/system/$VSSPIPESERVICENAME" ]; then
    sudo systemctl restart "$VSSPIPESERVICENAME" || return 1
    echo -e "$(ColorGreen 'VSS pipe service restarted')"
  else
    echo -e "$(ColorRed 'VSS pipe service does not exist')" >&2
    return 1
  fi
}

# Setup service with conf values, setup is $1=1; setdown is $1=2
function set_logrotate(){
	local logrotate_name="valheim-vss.logrotate"
	local logrotate_dir="${1:-/etc/logrotate.d}"
	mkdir -p "$CWD/systemd" || return 1
	if ! cp "$CWD/examples/valheim.logrotate" "$CWD/systemd/$logrotate_name"; then
		echo "Could not create the shared logrotate configuration." >&2
		return 1
	fi

	if ! sed -i "s[###VALHEIMSERVERLOGDIR###[$VALHEIMSERVERLOGDIR[g" "$CWD/systemd/$logrotate_name"; then
		echo "Could not configure the shared logrotate path." >&2
		return 1
	fi
	if grep -q '###.*###' "$CWD/systemd/$logrotate_name"; then
		echo "Unresolved placeholder in shared logrotate configuration" >&2
		return 1
	fi

	if ! sudo cp "$CWD/systemd/$logrotate_name" "$logrotate_dir/valheim-vss"; then
		echo -e "$(ColorRed 'Since sudo has failed, here is the commands we tried : ')" >&2
		echo -e "sudo cp \"$CWD/systemd/$logrotate_name\" \"$logrotate_dir/valheim-vss\"" >&2
		return 1
	fi
	sudo chown root:root "$logrotate_dir/valheim-vss" || return 1
	sudo chmod 0644 "$logrotate_dir/valheim-vss" || return 1
	echo -e "$(ColorGreen 'logrotate set')"
}

function remove_shared_logrotate() {
  local confirmation
  VSS_SETUP_NOTICE=''
  read -r -p "Remove the shared logrotate configuration for every server? Type REMOVE to confirm: " confirmation
  if [ "$confirmation" != "REMOVE" ]; then
    echo "Shared logrotate configuration was kept."
    VSS_SETUP_NOTICE='Shared log rotation was kept.'
    return 0
  fi
  if ! sudo rm -f /etc/logrotate.d/valheim-vss; then
    echo "Could not remove the shared logrotate configuration." >&2
    return 1
  fi
  if ! rm -f "$CWD/systemd/valheim-vss.logrotate"; then
    echo "Could not remove the generated shared logrotate file." >&2
    return 1
  fi
  VSS_SETUP_NOTICE='Shared log rotation removed.'
  return 0
}

function remove_profile_services() {
  local confirmation
  VSS_SETUP_NOTICE=''
  read -r -p "Remove this profile's services and scheduled update? Type REMOVE to confirm: " confirmation
  if [ "$confirmation" != "REMOVE" ]; then
    echo "Profile services and scheduled update were kept."
    VSS_SETUP_NOTICE="Profile services and scheduled update for $VSS_SERVER_NAME were kept."
    return 0
  fi

  uninstall_service "$VHSERVERSERVICENAME" || return 1
  uninstall_service "$VSSHTTPSERVICENAME" || return 1
  uninstall_service "$VSSPIPESERVICENAME" || return 1
  remove_profile_cron "$VSS_SERVER_NAME" || return 1
  VSS_SETUP_NOTICE="Services and scheduled update removed for $VSS_SERVER_NAME."
}

# Install / Active BepInEx_Valheim packaged version
function bepinex(){
	replace_env_value "$2" "VSSBEPINEXENABLED"
}

function bepinex_pipe_was_preexisting() {
  case "${VSSPIPEPREEXISTING:-}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [[ -e "/etc/systemd/system/$VSSPIPESERVICENAME" ||
     -L "/etc/systemd/system/$VSSPIPESERVICENAME" ]] ||
    systemctl is-active --quiet "$VSSPIPESERVICENAME" ||
    systemctl is-enabled --quiet "$VSSPIPESERVICENAME"
}

function restore_bepinex_activation() {
  local restart_server="$1"
  local recovery_failed=0

  if ! replace_env_value 'VSSBEPINEXENABLED' 0; then
    printf 'Failed to disable BepInEx for profile %s during recovery.\n' "$VSS_SERVER_NAME" >&2
    recovery_failed=1
  fi
  if ! "$VSSDIR/bepinex/remove_bepinex.sh"; then
    printf 'Failed to remove legacy BepInEx server links for profile %s.\n' "$VSS_SERVER_NAME" >&2
    recovery_failed=1
  fi
  if bepinex_pipe_was_preexisting; then
    if ! set_service "$VSSPIPESERVICENAME"; then
      printf 'Failed to restore the pre-existing log pipe for profile %s.\n' "$VSS_SERVER_NAME" >&2
      recovery_failed=1
    fi
  elif ! uninstall_service "$VSSPIPESERVICENAME"; then
    printf 'Failed to remove the BepInEx log pipe for profile %s during recovery.\n' "$VSS_SERVER_NAME" >&2
    recovery_failed=1
  fi

  if [ "$restart_server" -eq 1 ] && ! systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    sudo systemctl reset-failed "$VHSERVERSERVICENAME" || {
      printf 'Failed to clear the failed state for %s before recovery.\n' "$VHSERVERSERVICENAME" >&2
      recovery_failed=1
    }
    if ! start_valheim_service; then
      printf 'Could not restore the previously running server %s.\n' "$VHSERVERSERVICENAME" >&2
      recovery_failed=1
    fi
  fi

  return "$recovery_failed"
}

function enable_bepinex_profile() {
  local server_was_active=0
  local pipe_was_active=0
  local pipe_was_preexisting=0
  local running_pid
  VSS_SETUP_NOTICE=''
  printf '%s\n' "Sudo is needed to install/start this profile's systemd log-pipe service and stop/restart its Valheim service if running; downloading BepInEx itself does not require sudo."

  if [ "${VSSBEPINEXENABLED:-0}" = 1 ]; then
    if systemctl is-active --quiet "$VSSPIPESERVICENAME"; then
      pipe_was_active=1
    fi
    if ! "$VSSDIR/bepinex/install_bepinex.sh" ||
       ! set_service "$VSSPIPESERVICENAME"; then
      VSS_SETUP_NOTICE="BepInEx is enabled, but its profile or log pipe could not be prepared."
      return 1
    fi
    if [ "$pipe_was_active" -eq 1 ] && ! restart_vsspipe_service; then
      VSS_SETUP_NOTICE="BepInEx is enabled, but its log pipe could not be restarted."
      return 1
    fi
    VSS_SETUP_NOTICE="BepInEx was already enabled; its profile and log pipe are ready."
    return 0
  fi

  if systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    server_was_active=1
    if ! stop_valheim_service; then
      VSS_SETUP_NOTICE="Could not stop $VHSERVERSERVICENAME; BepInEx was not enabled."
      if systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
        VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The service is still active; its profile configuration was left unchanged."
        return 1
      fi
      if ! start_valheim_service; then
        VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
      fi
      return 1
    fi
  else
    running_pid="$(vss_find_server_pid || true)"
    if [ -n "$running_pid" ]; then
      printf 'Valheim is running outside its systemd service (PID %s); stop it before enabling BepInEx.\n' "$running_pid" >&2
      VSS_SETUP_NOTICE="BepInEx was not enabled because the running server is not managed by its systemd unit."
      return 1
    fi
  fi

  if systemctl is-active --quiet "$VSSPIPESERVICENAME"; then
    pipe_was_active=1
  fi

  if [ "${VSSBEPINEXENABLED:-0}" != 1 ]; then
    if [[ -e "/etc/systemd/system/$VSSPIPESERVICENAME" ||
          -L "/etc/systemd/system/$VSSPIPESERVICENAME" ]] ||
       systemctl is-active --quiet "$VSSPIPESERVICENAME" ||
       systemctl is-enabled --quiet "$VSSPIPESERVICENAME"; then
      pipe_was_preexisting=1
    fi
    if ! replace_env_value 'VSSPIPEPREEXISTING' "$pipe_was_preexisting"; then
      VSS_SETUP_NOTICE="Could not record the existing log-pipe state for profile $VSS_SERVER_NAME."
      if [ "$server_was_active" -eq 1 ] && ! start_valheim_service; then
        VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
      fi
      return 1
    fi
  fi

  if ! replace_env_value 'VSSBEPINEXENABLED' 1; then
    VSS_SETUP_NOTICE="Could not update the BepInEx setting for profile $VSS_SERVER_NAME."
    if ! restore_bepinex_activation "$server_was_active"; then
      VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE Recovery was incomplete; check the service status."
    fi
    return 1
  fi
  if ! "$VSSDIR/bepinex/install_bepinex.sh"; then
    VSS_SETUP_NOTICE="BepInEx installation failed; the profile was returned to disabled mode."
    if ! restore_bepinex_activation "$server_was_active"; then
      VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE Recovery was incomplete; check the service status."
    fi
    return 1
  fi
  if ! set_service "$VSSPIPESERVICENAME"; then
    VSS_SETUP_NOTICE="Could not install or start the BepInEx log pipe; BepInEx was disabled again."
    if ! restore_bepinex_activation "$server_was_active"; then
      VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE Recovery was incomplete; check the service status."
    fi
    return 1
  fi
  if [ "$pipe_was_active" -eq 1 ] && ! restart_vsspipe_service; then
    VSS_SETUP_NOTICE="Could not restart the BepInEx log pipe; BepInEx was disabled again."
    if ! restore_bepinex_activation "$server_was_active"; then
      VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE Recovery was incomplete; check the service status."
    fi
    return 1
  fi

  if [ "$server_was_active" -eq 1 ]; then
    if ! start_valheim_service; then
      VSS_SETUP_NOTICE="BepInEx server start failed; restoring the server in disabled mode."
      if ! restore_bepinex_activation 1; then
        VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE Recovery was incomplete; check the service status."
      fi
      return 1
    fi
    VSS_SETUP_NOTICE="BepInEx enabled; the previously running server was restarted with BepInEx."
  else
    VSS_SETUP_NOTICE="BepInEx enabled; the server remains stopped and will load BepInEx on its next start."
  fi
  return 0
}

function disable_bepinex_profile() {
  local server_was_active=0
  local keep_pipe=0
  local running_pid
  VSS_SETUP_NOTICE=''

  if systemctl is-active --quiet "$VHSERVERSERVICENAME"; then
    server_was_active=1
    if ! stop_valheim_service; then
      VSS_SETUP_NOTICE="Could not stop $VHSERVERSERVICENAME; BepInEx settings and its log pipe were left unchanged."
      if ! systemctl is-active --quiet "$VHSERVERSERVICENAME" &&
         ! start_valheim_service; then
        VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
      fi
      return 1
    fi
  else
    running_pid="$(vss_find_server_pid || true)"
    if [ -n "$running_pid" ]; then
      VSS_SETUP_NOTICE="BepInEx was not disabled because the running server is not managed by its systemd unit."
      return 1
    fi
  fi

  if ! replace_env_value 'VSSBEPINEXENABLED' 0; then
    VSS_SETUP_NOTICE="Could not disable BepInEx in profile $VSS_SERVER_NAME."
    if [ "$server_was_active" -eq 1 ] && ! start_valheim_service; then
      VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
    fi
    return 1
  fi
  if ! "$VSSDIR/bepinex/remove_bepinex.sh"; then
    VSS_SETUP_NOTICE="Could not remove BepInEx links for profile $VSS_SERVER_NAME; restoring enabled mode."
    replace_env_value 'VSSBEPINEXENABLED' 1 || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The enabled flag could not be restored."
    "$VSSDIR/bepinex/install_bepinex.sh" || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE BepInEx links could not be restored."
    if [ "$server_was_active" -eq 1 ]; then
      set_service "$VSSPIPESERVICENAME" || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The BepInEx log pipe could not be restored."
      start_valheim_service || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
    fi
    return 1
  fi

  if bepinex_pipe_was_preexisting; then
    keep_pipe=1
    if ! set_service "$VSSPIPESERVICENAME"; then
      VSS_SETUP_NOTICE="Could not keep the pre-existing log pipe for profile $VSS_SERVER_NAME; restoring enabled mode."
      replace_env_value 'VSSBEPINEXENABLED' 1 || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The enabled flag could not be restored."
      "$VSSDIR/bepinex/install_bepinex.sh" || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE BepInEx links could not be restored."
      set_service "$VSSPIPESERVICENAME" || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The log pipe could not be restored."
      if [ "$server_was_active" -eq 1 ]; then
        start_valheim_service || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
      fi
      return 1
    fi
  elif ! uninstall_service "$VSSPIPESERVICENAME"; then
    VSS_SETUP_NOTICE="Could not remove the BepInEx log pipe for profile $VSS_SERVER_NAME; restoring enabled mode."
    replace_env_value 'VSSBEPINEXENABLED' 1 || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The enabled flag could not be restored."
    "$VSSDIR/bepinex/install_bepinex.sh" || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE BepInEx links could not be restored."
    set_service "$VSSPIPESERVICENAME" || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The BepInEx log pipe could not be restored."
    if [ "$server_was_active" -eq 1 ]; then
      start_valheim_service || VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
    fi
    return 1
  fi

  if ! replace_env_value 'VSSPIPEPREEXISTING' ''; then
    VSS_SETUP_NOTICE="BepInEx was disabled, but the previous log-pipe state could not be cleared."
    if [ "$server_was_active" -eq 1 ] && ! start_valheim_service; then
      VSS_SETUP_NOTICE="$VSS_SETUP_NOTICE The previously running server could not be restarted."
    fi
    return 1
  fi

  if [ "$server_was_active" -eq 1 ]; then
    if ! start_valheim_service; then
      VSS_SETUP_NOTICE="BepInEx was disabled and its log pipe removed, but the vanilla server could not be restarted."
      return 1
    fi
    if [ "$keep_pipe" -eq 1 ]; then
      VSS_SETUP_NOTICE="BepInEx disabled; the pre-existing log pipe was kept, and the server was restarted in vanilla mode."
    else
      VSS_SETUP_NOTICE="BepInEx disabled and its log pipe removed; the previously running server was restarted in vanilla mode."
    fi
  else
    if [ "$keep_pipe" -eq 1 ]; then
      VSS_SETUP_NOTICE="BepInEx disabled; the pre-existing log pipe was kept, and the server remains stopped."
    else
      VSS_SETUP_NOTICE="BepInEx disabled and its log pipe removed; the server remains stopped."
    fi
  fi
  return 0
}

# new menus
function discord_menu() {
  local choice
  local selected=1
  local notice=''
  while true; do
    setup_menu_render 'Discord and webhook' "$notice"
    notice=''
    printf 'One Discord webhook URL is shared by all profiles; each profile uses one message for status, connection details, and optional logs.\n\n'
    setup_ui_menu_option "$selected" 1 'Set shared webhook URL'
    setup_ui_menu_option "$selected" 2 'Set shared number of recent logs'
    setup_ui_menu_option "$selected" 3 'Send an update for this profile now'
    setup_ui_menu_option "$selected" 4 'Set this profile webhook message ID'
    setup_ui_menu_option "$selected" 5 'Include connection details in status message (shared)'
    setup_ui_menu_option "$selected" 6 'Toggle shared real-time event updates'
    setup_ui_menu_option "$selected" 7 'Set shared webhook language (en/fr)'
    setup_ui_menu_option "$selected" 8 'Set shared automatic update frequency (minutes; 0 disables)'
    setup_ui_menu_option "$selected" 9 'Disable automatic updates for every profile'
    printf '\n'
    setup_ui_menu_option "$selected" 0 'Return'
    printf '\n'
    printf 'Select an action: '
    setup_ui_read_menu_choice 9 "$selected" || return 0
    choice="$SETUP_UI_CHOICE"
    if [ "$choice" = '__redraw__' ]; then
      selected="$SETUP_UI_SELECTED_CHOICE"
      continue
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] && (( choice <= 9 )) && selected="$choice"
    case "$choice" in
      1)
        if setup_value_prompt 'Shared Discord webhook URL (hidden)' WEBHOOKURL; then
          notice='Shared webhook URL updated for all profiles.'
        else
          notice='Webhook URL was not changed.'
        fi
        ;;
      2)
        if setup_value_prompt 'Number of recent logs sent to Discord' SENDLASTLOGS; then
          notice='Recent-log setting updated.'
        else
          notice='Recent-log setting was not changed.'
        fi
        ;;
      3)
        if run_discord_update; then
          notice="Discord update completed for $VSS_SERVER_NAME."
        else
          notice="Discord update failed for $VSS_SERVER_NAME; review the error above."
        fi
        ;;
      4)
        if setup_value_prompt 'Webhook message ID for this profile (status, connection, and logs)' STATUSMESSAGEID; then
          notice='Webhook message ID updated.'
        else
          notice='Webhook message ID was not changed.'
        fi
        ;;
      5)
        if setup_value_prompt 'Include connection details in each profile status message? (1=yes, 0=no)' SENDSERVERCONNECTIONINFO; then
          notice='Shared status-message connection details setting updated.'
        else
          notice='Status-message connection details setting was not changed.'
        fi
        ;;
      6)
        if setup_value_prompt 'Send real-time event updates? (1=yes, 0=no)' EVENTREALTIME; then
          notice='Shared real-time update setting changed; restart running log filters to apply it.'
        else
          notice='Real-time update setting was not changed.'
        fi
        ;;
      7)
        if setup_value_prompt 'Shared webhook language (en or fr)' VSS_LANG; then
          notice='Shared webhook language updated.'
        else
          notice='Webhook language was not changed.'
        fi
        ;;
      8)
        if setup_value_prompt 'Shared automatic update frequency in minutes (0 disables)' CRONTABWEBHOOKFREQ &&
           set_cron; then
          notice='Automatic update jobs refreshed for all profiles.'
        else
          notice='Could not update automatic Discord jobs; review the error above.'
        fi
        ;;
      9)
        if replace_env_value CRONTABWEBHOOKFREQ 0 && set_cron; then
          notice='Automatic Discord jobs disabled for all profiles.'
        else
          notice='Could not remove automatic Discord jobs; review the error above.'
        fi
        ;;
      0) return 0 ;;
      *) notice="Unknown option: $choice" ;;
    esac
  done
}

# new menus
function admin_list_file() {
  case "$1" in
    admin) echo "$VHSERVERSAVEDIR/adminlist.txt" ;;
    banned) echo "$VHSERVERSAVEDIR/bannedlist.txt" ;;
    permitted) echo "$VHSERVERSAVEDIR/permittedlist.txt" ;;
    *) echo "$VHSERVERSAVEDIR/${1}list.txt" ;;
  esac
}

function known_players_display() {
  local known_file
  local line
  local pseudo
  local player_id
  local display_entries=""


	if [ -f "$STEAMIDMAPFILE" ]; then
	while IFS=';' read -r player_id pseudo; do
		if [ -n "$pseudo" ] && [ -n "$player_id" ]; then
			if ! printf '%s\n' "$display_entries" | grep -Fq "${player_id}:${pseudo}"; then
				if [ -n "$display_entries" ]; then
				display_entries="${display_entries} | ${player_id}:${pseudo}"
				else
				display_entries="${player_id}:${pseudo}"
				fi
			fi
		fi
	done < "$STEAMIDMAPFILE"
		if [ -n "$display_entries" ]; then
		echo "--- known players ---"
		echo "$display_entries"
		fi
	fi
}

function admin_list_show() {
  local list_name="$1"
  local file
  mkdir -p "$VHSERVERSAVEDIR" || return 1
  file="$(admin_list_file "$list_name")"
  if [ -f "$file" ]; then
    echo "--- ${list_name} list ---"
    cat "$file" || return 1
  else
    echo "--- ${list_name} list ---"
    echo "(empty or missing)"
  fi
}

function admin_list_add() {
  local list_name="$1"
  local player_id
  local file
  mkdir -p "$VHSERVERSAVEDIR" || return 1
  file="$(admin_list_file "$list_name")"
  known_players_display
  echo "enter player ID to add to ${list_name}:"
  read -r player_id || return 1
  if [ -z "$player_id" ]; then
    echo "empty value, aborted" >&2
    return 1
  fi
  if [ -f "$file" ] && grep -Fqx "V_$player_id" "$file"; then
    echo "V_$player_id already exists in ${list_name} list" >&2
    return 1
  fi
  if ! printf 'V_%s\n' "$player_id" >> "$file"; then
    echo "Could not update ${list_name} list." >&2
    return 1
  fi
  echo "V_$player_id added to ${list_name} list"
}

function admin_list_remove() {
  local list_name="$1"
  local player_id
  local file
  local tmp_file
  local grep_status
  mkdir -p "$VHSERVERSAVEDIR" || return 1
  file="$(admin_list_file "$list_name")"
  known_players_display
  echo "enter player ID to remove from ${list_name}:"
  read -r player_id || return 1
  if [ -z "$player_id" ]; then
    echo "empty value, aborted" >&2
    return 1
  fi
  if [ ! -f "$file" ] || ! grep -Fqx "V_$player_id" "$file"; then
    echo "V_$player_id not found in ${list_name} list" >&2
    return 1
  fi
  tmp_file="$(mktemp)" || return 1
  grep -Fvx "V_$player_id" "$file" > "$tmp_file"
  grep_status=$?
  if [ "$grep_status" -gt 1 ]; then
    rm -f -- "$tmp_file"
    echo "Could not read ${list_name} list." >&2
    return 1
  fi
  if ! mv -- "$tmp_file" "$file"; then
    rm -f -- "$tmp_file"
    echo "Could not update ${list_name} list." >&2
    return 1
  fi
  echo "V_$player_id removed from ${list_name} list"
}

