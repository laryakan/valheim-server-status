discord_menu(){
vss_header
echo -ne "
*** $(ColorMagenta 'Discord') menu ***
$(ColorYellow 'Webhook credentials and send options are shared across profiles; message IDs belong to this profile.')
$(ColorRed 'Remember to first create your webhook on Discord and activate developer mode (in appereance menu)')
$(ColorGreen '1)') setup current $(ColorMagenta 'Discord') webhook URL
$(ColorGreen '2)') setup 'how many' wanted last logs on your $(ColorMagenta 'Discord') channel
$(ColorGreen '3)') force $(ColorMagenta 'Discord') webhook update
$(ColorGreen '4)') setup current $(ColorMagenta 'Discord') webhook status message id
$(ColorGreen '5)') setup current $(ColorMagenta 'Discord') webhook last logs message id
$(ColorGreen '6)') setup current $(ColorMagenta 'Discord') webhook connection info message id
$(ColorGreen '7)') enable or disable connection info on your webhook (1 or 0)
$(ColorGreen '8)') enable or disable realtime in-game event update on your webhook (1 or 0) (things using the log-filter have to restart)
$(ColorGreen '9)') setup webhook language (available: en, fr)
$(ColorGreen '10)') setup $(ColorMagenta 'Discord') webhook update cron frequency (Valheim Server heartbeat)
$(ColorGreen '11)') remove webhook crontab (no more auto-update)

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			1) setup_value_prompt "what's your $(ColorMagenta 'Discord') webhook url ?" 'WEBHOOKURL' ; clear ; discord_menu ;;
	        2) setup_value_prompt "how many logs do you want on your $(ColorMagenta 'Discord') ? set '0' if you dont want any" 'SENDLASTLOGS' ; clear ; discord_menu ;;
	        3) "$CWD/discord/update" ; clear ; discord_menu ;;
	        4) setup_value_prompt "what's the $(ColorMagenta 'Discord') webhook status message id ?" 'STATUSMESSAGEID' ; clear ; discord_menu ;;
	        5) setup_value_prompt "what's the $(ColorMagenta 'Discord') webhook 'last logs' message id ?" 'LASTLOGMESSAGEID' ; clear ; discord_menu ;;
			6) setup_value_prompt "what's the $(ColorMagenta 'Discord') webhook 'connection info' message id ?" 'SERVERCONNECTIONINFOMESSAGEID' ; clear ; discord_menu ;;
			7) setup_value_prompt 'do you want the connection info message to be sent to Discord ? (set "1" for true, "0" for false)' 'SENDSERVERCONNECTIONINFO' ; clear ; discord_menu ;;
			8) setup_value_prompt 'do you want the webhook messages to auto-update at each in-game event ? (set "1" for true, "0" for false)' 'EVENTREALTIME' ; clear ; discord_menu ;;
			9) setup_value_prompt 'choose your Discord webhook language (available values: en, fr)' 'VSS_LANG' ; clear ; discord_menu ;;
			10) setup_value_prompt "at which frequency do you want your $(ColorMagenta 'Discord') webhook to send message (in minutes) ? set '0' if you dont want an auto-update cron" 'CRONTABWEBHOOKFREQ' ; set_cron ; sleep 2 ; clear ; discord_menu ;;
			11) replace_env_value 'CRONTABWEBHOOKFREQ' 0 ; set_cron ; sleep 2 ; clear ; discord_menu ;;
			
		0) setup_ui_clear; return 0 ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

# new menus
function admin_list_file() {
  case "$1" in
    admin) echo "$VHSERVERSAVEDIR/adminlist.txt" ;;
    banned) echo "$VHSERVERSAVEDIR/bannedlist.txt" ;;
    permitted) echo "$VHSERVERSAVEDIR/permittedlist.txt" ;;
    *) echo "$VHSERVERSAVEDIR/${1}list.txt" ;;
  esac
}

function known_players_display() {
  local known_file
  local line
  local pseudo
  local player_id
  local display_entries=""


	if [ -f "$STEAMIDMAPFILE" ]; then
	while IFS=';' read -r player_id pseudo; do
		if [ -n "$pseudo" ] && [ -n "$player_id" ]; then
			if ! printf '%s\n' "$display_entries" | grep -Fq "${player_id}:${pseudo}"; then
				if [ -n "$display_entries" ]; then
				display_entries="${display_entries} | ${player_id}:${pseudo}"
				else
				display_entries="${player_id}:${pseudo}"
				fi
			fi
		fi
	done < "$STEAMIDMAPFILE"
		if [ -n "$display_entries" ]; then
		echo "--- known players ---"
		echo "$display_entries"
		fi
	fi
}

function admin_list_show() {
  local list_name="$1"
  local file
  mkdir -p "$VHSERVERSAVEDIR"
  file="$(admin_list_file "$list_name")"
  if [ -f "$file" ]; then
    echo "--- ${list_name} list ---"
    cat "$file"
  else
    echo "--- ${list_name} list ---"
    echo "(empty or missing)"
  fi
}

function admin_list_add() {
  local list_name="$1"
  local player_id
  local file
  mkdir -p "$VHSERVERSAVEDIR"
  file="$(admin_list_file "$list_name")"
  known_players_display
  echo "enter player ID to add to ${list_name}:"
  read -r player_id
  if [ -z "$player_id" ]; then
    echo "empty value, aborted" >&2
    return
  fi
  if [ -f "$file" ] && grep -Fqx "V_$player_id" "$file"; then
    echo "V_$player_id already exists in ${list_name} list" >&2
    return
  fi
  echo "V_$player_id" >> "$file"
  echo "V_$player_id added to ${list_name} list"
}

function admin_list_remove() {
  local list_name="$1"
  local player_id
  local file
  local tmp_file
  mkdir -p "$VHSERVERSAVEDIR"
  file="$(admin_list_file "$list_name")"
  known_players_display
  echo "enter player ID to remove from ${list_name}:"
  read -r player_id
  if [ -z "$player_id" ]; then
    echo "empty value, aborted" >&2
    return
  fi
  if [ ! -f "$file" ] || ! grep -Fqx "V_$player_id" "$file"; then
    echo "V_$player_id not found in ${list_name} list" >&2
    return
  fi
  tmp_file="$(mktemp)"
  grep -Fvx "V_$player_id" "$file" > "$tmp_file"
  mv "$tmp_file" "$file"
  echo "V_$player_id removed from ${list_name} list"
}

launcher_menu(){
vss_header
echo -ne "
*** Valheim Server Launcher menu ***
$(ColorRed 'Warning: most launcher options only work when VSS starts the Valheim server itself. Setup options need a server restart.')
$(ColorRed 'PLEASE AVOID SPECIAL CHARACTERS IN YOUR SERVER NAME OR WORLD NAME.')
$(ColorGreen '1)') $(ColorYellow 'auto-conf custom launcher') if your server is running! this will set 2),3),4),5),6),7),8)
$(ColorGreen '2)') setup current Valheim server directory
$(ColorGreen '3)') setup wanted Valheim server listening port
$(ColorGreen '4)') setup wanted Valheim server name
$(ColorGreen '5)') setup wanted Valheim server world name
$(ColorGreen '6)') setup wanted Valheim server password
$(ColorGreen '7)') set the informational Valheim world seed shown in Discord
$(ColorGreen '8)') setup wanted Valheim server savedir value
$(ColorGreen '9)') setup crossplay
$(ColorGreen '10)') $(ColorRed 'sudo required') create or reinstall valheim-server.service in /etc/systemd/system
$(ColorGreen '11)') $(ColorRed 'sudo required') remove valheim-server.service from /etc/systemd/system
$(ColorGreen '12)') $(ColorRed 'sudo required') stop the existing service and shut down the server
$(ColorGreen '13)') $(ColorRed 'sudo required') start the existing service and run the server
$(ColorGreen '14)') $(ColorRed 'sudo required') restart the existing service and the server
$(ColorGreen '15)') $(ColorRed 'sudo required') $(ColorYellow 'delete my old world and start a new one (stop server, delete saved world, start server)')
$(ColorGreen '16)') set the optional R2Modman profile code shared with players via Discord

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			1) auto_conf ; clear ; launcher_menu ;;
			2) setup_value_prompt 'where is located your dedicated server ?' 'VHSERVERDIR' ; clear ; launcher_menu ;;
			3) setup_value_prompt 'on which port do you want your server to listen (default: 2456) ?' 'VHSERVERPORT' ; clear ; launcher_menu ;;
	        4) setup_value_prompt "what is your $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim server name ?" 'VHSERVERNAME' ; clear ; launcher_menu ;;
	        5) setup_value_prompt "what is your $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim World name ? $(ColorRed 'If you already have a server, put its World name here')" 'VHSERVERWORLD' ; clear ; launcher_menu ;;
	        6) setup_value_prompt "what is your $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim server password ?" 'VHSERVERPASSWD' ; clear ; launcher_menu ;;
			7) setup_value_prompt "what is the current Valheim world seed to display in Discord?" 'VHSERVERSEED' ; clear ; launcher_menu ;;
			8) setup_value_prompt "what is your wanted $(ColorYellow 'current') or $(ColorCyan 'wanted') Valheim server savedir ?" 'VHSERVERSAVEDIR' ; clear ; launcher_menu ;;
			9) setup_value_prompt 'set crossplay on/off: 1 = crossplay active, 0 = crossplay inactive' 'VHSERVERCROSSPLAY' ; clear ; launcher_menu ;;
			10) set_service "$VHSERVERSERVICENAME"; sleep 2 ; "$CWD/discord/update" ; clear ; launcher_menu ;;
			11) uninstall_service "$VHSERVERSERVICENAME"; sleep 2 ; "$CWD/discord/update" ; clear ; launcher_menu ;;
			12) stop_valheim_service ; sleep 2 ; "$CWD/discord/update" ; clear ; launcher_menu ;;
			13) start_valheim_service ; sleep 2 ; "$CWD/discord/update" ; clear ; launcher_menu ;;
			14) restart_valheim_service ; sleep 2 ; "$CWD/discord/update" ; clear ; launcher_menu ;;
			15) 
				if [ -n "$VHSERVERWORLD" ]; then
					stop_valheim_service
					WORLD_FILES_DIR="$VHSERVERSAVEDIR/worlds_local"
					mkdir -p "$WORLD_FILES_DIR"
					find "$WORLD_FILES_DIR" -maxdepth 1 -type f \( -name "${VHSERVERWORLD}.fwl" -o -name "${VHSERVERWORLD}.db" -o -name "${VHSERVERWORLD}*.fwl" -o -name "${VHSERVERWORLD}*.db" \) -print -delete
					start_valheim_service
				else
					echo -e "$(ColorRed 'VHSERVERWORLD is empty; cannot delete the current world.')" >&2
				fi
				sleep 2 ; "$CWD/discord/update" ; clear ; launcher_menu ;;
			16) setup_value_prompt 'set the optional R2Modman profile code (shown in Discord when BepInEx is enabled)' 'R2MODMANCODE' ; clear ; launcher_menu ;;

		0) setup_ui_clear; return 0 ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

admin_menu(){
vss_header
echo -ne "
*** VSS Admin menu ***
$(ColorGreen '1)') [Show] Admin
$(ColorGreen '2)') [Add] Admin
$(ColorGreen '3)') [Remove] Admin
$(ColorGreen '4)') [Show] Banned
$(ColorGreen '5)') [Add] Banned
$(ColorGreen '6)') [Remove] Banned
$(ColorGreen '7)') [Show] Permitted
$(ColorGreen '8)') [Add] Permitted
$(ColorGreen '9)') [Remove] Permitted

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			1) admin_list_show 'admin' ; sleep 5 ; clear ; admin_menu ;;
			2) admin_list_add 'admin' ; sleep 5 ; clear ; admin_menu ;;
			3) admin_list_remove 'admin' ; sleep 5 ; clear ; admin_menu ;;
			4) admin_list_show 'banned' ; sleep 5 ; clear ; admin_menu ;;
			5) admin_list_add 'banned' ; sleep 5 ; clear ; admin_menu ;;
			6) admin_list_remove 'banned' ; sleep 5 ; clear ; admin_menu ;;
			7) admin_list_show 'permitted' ; sleep 5 ; clear ; admin_menu ;;
			8) admin_list_add 'permitted' ; sleep 5 ; clear ; admin_menu ;;
			9) admin_list_remove 'permitted' ; sleep 5 ; clear ; admin_menu ;;
		0) setup_ui_clear; return 0 ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

# new menus
http_status_menu(){
vss_header
echo -ne "
*** VSS over HTTP menu ***
$(ColorGreen '1)') setup wanted Valheim server status over HTTP public URL (host:port)
$(ColorGreen '2)') $(ColorRed 'sudo required'), add and activate VSS.http.service (server status over HTTP)
$(ColorGreen '3)') $(ColorRed 'sudo required') remove VSS.http.service (server status over HTTP)

$(ColorGreen '0)') return to previous menu
$(ColorGreen 'CTRL+C)') quit
$(ColorBlue 'You can scroll up to see previous screens')
$(ColorBlue 'choose an option:') "
mkdir -p "$CWD/systemd"
        read a
        case $a in
			 1) setup_value_prompt 'set the public URL of your VSS over HTTP status (http://host:port) ?' 'STATUSURL' ; clear ; http_status_menu ;;
			 2) set_service "$VSSHTTPSERVICENAME"; sleep 2 ; clear ; http_status_menu ;;
			 3) uninstall_service "$VSSHTTPSERVICENAME" ; clear ; http_status_menu ;;

		0) setup_ui_clear; return 0 ;;
		*) echo -e $red"Wrong option."$clear >&2; WrongCommand;;
        esac
}

# Main menu
new_menu(){
  local a
  local confirmation
  local notice=""
  while true; do
    setup_ui_header "Main menu"
    if [ -n "$notice" ]; then
      printf '\n%s\n' "$notice"
      notice=""
    fi
    setup_ui_dashboard
    printf '\nCONFIGURATION\n'
    printf '  1  Discord and webhook\n'
    printf '  2  Valheim launcher and server\n'
    printf '  3  HTTP status endpoint\n'
    printf '  4  Admin, ban, and permitted lists\n'
    printf '\nMONITORING AND SERVICES\n'
    printf '  5  Configure server log path\n'
    printf '  6  Install or update log pipe service (sudo)\n'
    printf '  7  Restart log pipe service (sudo)\n'
    printf '  8  Remove log pipe service (sudo)\n'
    printf '  9  Install shared log rotation (sudo)\n'
    printf ' 10  Remove shared log rotation (sudo)\n'
    printf '\nMAINTENANCE\n'
    printf ' 11  Set system service user\n'
    printf " 12  Remove this profile's services and scheduled update (sudo)\n"
    printf ' 13  Enable packaged BepInEx\n'
    printf ' 14  Disable packaged BepInEx\n'
    printf ' 15  Switch server profile\n'
    printf ' 16  Update Valheim server (stops all instances first; restarts only those previously active)\n'
    printf ' 17  Schedule global maintenance daily at 05:00 local time (root crontab; sudo)\n'
    printf ' 18  Remove the global maintenance schedule (root crontab; sudo)\n'
    printf '\n  0  Exit\n\n'
    printf 'Select an action: '
    read -r a || return 0
    case "$a" in
      1) setup_ui_clear; discord_menu ;;
      2) setup_ui_clear; launcher_menu ;;
      3) setup_ui_clear; http_status_menu ;;
      4) setup_ui_clear; admin_menu ;;
      5) setup_value_prompt 'Where are your server logs (file, directory, or wildcard path)?' 'VALHEIMSERVERLOGPATH' ;;
      6) set_service "$VSSPIPESERVICENAME"; sleep 2 ;;
      7) restart_vsspipe_service ;;
      8) uninstall_service "$VSSPIPESERVICENAME" ;;
      9) set_logrotate; sleep 5 ;;
      10) remove_shared_logrotate ;;
      11) setup_value_prompt 'Which user should run the services?' 'USERSERVICE' ;;
      12) remove_profile_services ;;
      13) replace_env_value 'VSSBEPINEXENABLED' 1; "$VSSDIR/bepinex/install_bepinex.sh"; sleep 1 ;;
      14) replace_env_value 'VSSBEPINEXENABLED' 0; "$VSSDIR/bepinex/remove_bepinex.sh"; sleep 1 ;;
      15)
        if select_server_profile; then
          load_server_profile "$SELECTED_SERVER_PROFILE" || continue
        fi
        ;;
      16)
        printf 'This updates shared Valheim server files. Every installed server instance will be stopped first; only instances that were running will be restarted sequentially.\n'
        printf 'Type UPDATE to continue: '
        read -r confirmation
        if [ "$confirmation" = "UPDATE" ]; then
          run_server_maintenance || notice="Maintenance failed; review the errors above and service status."
        else
          notice="Maintenance cancelled."
        fi
        ;;
      17)
        printf 'This adds one global daily maintenance job at 05:00 local time to root'\''s crontab. Remove any older manual vss.maintenance entry first to avoid duplicate updates.\n'
        printf 'Type SCHEDULE to continue: '
        read -r confirmation
        if [ "$confirmation" = "SCHEDULE" ]; then
          set_maintenance_cron || notice="Could not schedule maintenance; review the error above."
        else
          notice="Maintenance schedule was not changed."
        fi
        ;;
      18)
        printf 'Type REMOVE to delete the global maintenance entry from root'\''s crontab: '
        read -r confirmation
        if [ "$confirmation" = "REMOVE" ]; then
          remove_maintenance_cron || notice="Could not remove the maintenance schedule; review the error above."
        else
          notice="Maintenance schedule was kept."
        fi
        ;;
      0) exit 0 ;;
      *) notice="Unknown option: $a" ;;
    esac
  done
}

function setup_usage() {
  cat <<'EOF'
Usage:
  ./setup [SERVER_NAME]
  ./setup --list
  ./setup --create SERVER_NAME
  ./setup --schedule-maintenance
  ./setup --remove-maintenance-schedule
  ./setup --maintenance-update
  ./setup --start-server SERVER_NAME
  ./setup --stop-server SERVER_NAME
  ./setup --restart-server SERVER_NAME
  ./setup --status-server SERVER_NAME
  ./setup --check-firewall SERVER_NAME
  ./setup --discord-update SERVER_NAME
  ./migrate-v2-to-v3
EOF
}

function run_discord_update() {
  printf 'Updating Discord for profile %s...\n' "$VSS_SERVER_NAME"
  if ! "$CWD/discord/update"; then
    printf 'Discord update failed for profile %s; see crash.log for details.\n' "$VSS_SERVER_NAME"
    return 1
  fi
  printf 'Discord update completed for profile %s.\n' "$VSS_SERVER_NAME"
}

function run_server_cli_action() {
  local action="$1"
  case "$action" in
    --start-server) start_valheim_service 2>&1 ;;
    --stop-server) stop_valheim_service 2>&1 ;;
    --restart-server) restart_valheim_service 2>&1 ;;
    --status-server) status_valheim_service 2>&1 ;;
    --check-firewall) check_ufw_profile_rules 2>&1 ;;
    --discord-update) run_discord_update 2>&1 ;;
    *) printf 'Unsupported direct action: %s\n' "$action"; return 2 ;;
  esac
}

function setup_main() {
  local selected_profile="${VSS_SERVER_NAME:-}"
  local profile
  local direct_action=""

  case "${1:-}" in
    --help|-h)
      setup_usage
      return 0
      ;;
    --list)
      list_server_profiles
      return 0
      ;;
    --maintenance-update)
      if [ -n "${2:-}" ]; then
        printf 'Option --maintenance-update does not accept a server name.\n'
        setup_usage
        return 2
      fi
      direct_action="$1"
      ;;
    --schedule-maintenance|--remove-maintenance-schedule)
      if [ -n "${2:-}" ]; then
        printf 'Option %s does not accept a server name.\n' "$1"
        setup_usage
        return 2
      fi
      direct_action="$1"
      ;;
    --start-server|--stop-server|--restart-server|--status-server|--check-firewall|--discord-update)
      if [ -z "${2:-}" ] || [ -n "${3:-}" ]; then
        printf 'Option %s requires exactly one server name.\n' "$1"
        setup_usage
        return 2
      fi
      direct_action="$1"
      ;;
  esac

  if [ -f "$CWD/.env" ] && ! grep -Fxq 'VSS_COMMON_CONFIG_VERSION=3' "$CWD/.env"; then
    printf 'A legacy .env was found. Run ./migrate-v2-to-v3 before using setup.\n' >&2
    return 1
  fi

  case "$direct_action" in
    --schedule-maintenance) set_maintenance_cron; return $? ;;
    --remove-maintenance-schedule) remove_maintenance_cron; return $? ;;
  esac

  if [ "$direct_action" = "--maintenance-update" ]; then
    if [ -z "$selected_profile" ]; then
      while IFS= read -r profile; do
        selected_profile="$profile"
        break
      done < <(list_server_profiles)
    fi
    if [ -z "$selected_profile" ] || ! load_server_profile "$selected_profile"; then
      printf 'No valid server profile is available for maintenance.\n' >&2
      return 1
    fi
    run_server_maintenance
    return $?
  fi

  if [ -n "$direct_action" ]; then
    if ! load_server_profile "$2"; then
      printf "Setup could not load profile '%s'. Review the error above and check its configuration.\n" "$2" >&2
      return 1
    fi
    run_server_cli_action "$direct_action"
    return $?
  fi

  case "${1:-}" in
    --create)
      if [ -z "${2:-}" ]; then
        return 1
      fi
      if ! create_server_profile "$2"; then
        return 1
      fi
      selected_profile="$2"
      ;;
    "")
      if [ -z "$selected_profile" ]; then
        select_server_profile || return 0
        selected_profile="$SELECTED_SERVER_PROFILE"
      fi
      ;;
    *)
      selected_profile="$1"
      ;;
  esac

  if ! load_server_profile "$selected_profile"; then
    printf "Setup could not load profile '%s'. Review the error above and check its configuration.\n" "$selected_profile" >&2
    return 1
  fi
  setup_ui_clear
  new_menu
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  setup_main "$@"
fi
