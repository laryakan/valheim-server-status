  done
}

function bepinex_menu() {
  local choice
  local selected=1
  local notice=''
  while true; do
    setup_menu_render 'BepInEx and modding' "$notice"
    notice=''
    setup_ui_menu_option "$selected" 1 'Enable BepInEx for this profile'
    setup_ui_menu_option "$selected" 2 'Disable BepInEx for this profile'
    setup_ui_menu_option "$selected" 3 'Set optional R2Modman/Thunderstore share code'
    printf '\n'
    setup_ui_menu_option "$selected" 0 'Return'
    printf '\n'
    printf 'Select an action: '
    setup_ui_read_menu_choice 3 "$selected" || return 0
    choice="$SETUP_UI_CHOICE"
    if [ "$choice" = '__redraw__' ]; then
      selected="$SETUP_UI_SELECTED_CHOICE"
      continue
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] && (( choice <= 3 )) && selected="$choice"
    case "$choice" in
      1)
        if enable_bepinex_profile; then
          notice="${VSS_SETUP_NOTICE:-BepInEx enabled.}"
        else
          notice="${VSS_SETUP_NOTICE:-Could not enable BepInEx and its log pipe; the profile was left disabled.}"
        fi
        ;;
      2)
        if disable_bepinex_profile; then
          notice="${VSS_SETUP_NOTICE:-BepInEx disabled.}"
        else
          notice="${VSS_SETUP_NOTICE:-Could not disable BepInEx cleanly; review the service status.}"
        fi
        ;;
      3)
        if setup_value_prompt 'Optional R2Modman/Thunderstore share code' R2MODMANCODE; then
          notice='Mod-manager share code updated.'
        else
          notice='Mod-manager share code was not changed.'
        fi
        ;;
      0) return 0 ;;
      *) notice="Unknown option: $choice" ;;
    esac
  done
}

# Main menu
new_menu(){
  local a
  local confirmation
  local selected=1
  local notice=""
  while true; do
    setup_ui_header "Main menu"
    if [ -n "$notice" ]; then
      printf '\n%s\n' "$notice"
      notice=""
    fi
    setup_ui_dashboard
    printf '\nCONFIGURATION\n'
    setup_ui_menu_option "$selected" 1 'Discord and webhook'
    setup_ui_menu_option "$selected" 2 'Valheim launcher and server'
    setup_ui_menu_option "$selected" 3 'HTTP status endpoint'
    setup_ui_menu_option "$selected" 4 'Admin, ban, and permitted lists'
    printf '\nMONITORING AND SERVICES\n'
    setup_ui_menu_option "$selected" 5 'Configure server log path'
    setup_ui_menu_option "$selected" 6 'Repair/install standalone log pipe (BepInEx or external logs; sudo)'
    setup_ui_menu_option "$selected" 7 'Restart standalone log pipe (sudo)'
    setup_ui_menu_option "$selected" 8 'Remove standalone log pipe (sudo)'
    setup_ui_menu_option "$selected" 9 'Install shared log rotation (sudo)'
    setup_ui_menu_option "$selected" 10 'Remove shared log rotation (sudo)'
    printf '\nMAINTENANCE\n'
    setup_ui_menu_option "$selected" 11 'Set system service user'
    setup_ui_menu_option "$selected" 12 "Remove this profile's services and scheduled update (sudo)"
    printf '\nBEPINEX AND MODDING\n'
    setup_ui_menu_option "$selected" 13 'BepInEx and modding'
    printf '\nPROFILE AND GLOBAL MAINTENANCE\n'
    setup_ui_menu_option "$selected" 14 'Switch server profile'
    setup_ui_menu_option "$selected" 15 'Update Valheim server (stops all instances first; restarts only those previously active)'
    setup_ui_menu_option "$selected" 16 'Schedule global maintenance daily at 05:00 local time (root crontab; sudo)'
    setup_ui_menu_option "$selected" 17 'Remove the global maintenance schedule (root crontab; sudo)'
    printf '\n'
    setup_ui_menu_option "$selected" 0 'Exit'
    printf '\n'
    printf 'Select an action: '
    setup_ui_read_menu_choice 17 "$selected" || return 0
    a="$SETUP_UI_CHOICE"
    if [ "$a" = '__redraw__' ]; then
      selected="$SETUP_UI_SELECTED_CHOICE"
      continue
    fi
    [[ "$a" =~ ^[0-9]+$ ]] && (( a <= 17 )) && selected="$a"
    case "$a" in
      1) setup_ui_clear; discord_menu ;;
      2) setup_ui_clear; launcher_menu ;;
      3) setup_ui_clear; http_status_menu ;;
      4) setup_ui_clear; admin_menu ;;
      5)
        if setup_value_prompt 'Where are your server logs (file, directory, or wildcard path)?' VALHEIMSERVERLOGPATH; then
          notice='Log-path configuration prompt completed.'
        else
          notice='Could not update the log path; review the error above.'
        fi
        ;;
      6)
        if set_service "$VSSPIPESERVICENAME"; then notice='Standalone log pipe installed and started.'
        else notice='Could not install or start the standalone log pipe; review the error above.'; fi
        ;;
      7)
        if restart_vsspipe_service; then notice='Standalone log pipe restarted.'
        else notice='Could not restart the standalone log pipe; review the error above.'; fi
        ;;
      8)
        if uninstall_service "$VSSPIPESERVICENAME"; then notice='Standalone log pipe removed.'
        else notice='Could not remove the standalone log pipe; its remaining state was kept for recovery.'; fi
        ;;
      9)
        if set_logrotate; then notice='Shared log rotation installed or updated.'
        else notice='Could not install shared log rotation; review the error above.'; fi
        ;;
      10)
        if remove_shared_logrotate; then notice="${VSS_SETUP_NOTICE:-Shared log rotation removal completed.}"
        else notice='Could not remove shared log rotation; review the error above.'; fi
        ;;
      11)
        if setup_value_prompt 'Which user should run the services?' USERSERVICE; then
          notice='Service-user configuration prompt completed.'
        else
          notice='Could not update the service user; review the error above.'
        fi
        ;;
      12)
        if remove_profile_services; then notice="${VSS_SETUP_NOTICE:-Profile service removal completed.}"
        else notice='Could not remove all profile services; review the errors above.'; fi
        ;;
      13)
        bepinex_menu
        ;;
      14)
        if select_server_profile; then
          if load_server_profile "$SELECTED_SERVER_PROFILE"; then
            notice="Active profile is now $VSS_SERVER_NAME."
          else
            if [ "$VSS_PROFILE_RESTORE_FAILED" -eq 1 ]; then
              notice="Could not load $SELECTED_SERVER_PROFILE; restoration of the previous profile failed."
            else
              notice="Could not load $SELECTED_SERVER_PROFILE; the previous profile was restored."
            fi
          fi
        fi
        ;;
      15)
        printf 'This updates shared Valheim server files. Every installed server instance will be stopped first; only instances that were running will be restarted sequentially.\n'
        printf 'Type UPDATE to continue: '
        read -r confirmation
        if [ "$confirmation" = "UPDATE" ]; then
          run_server_maintenance || notice="Maintenance failed; review the errors above and service status."
        else
          notice="Maintenance cancelled."
        fi
        ;;
      16)
        printf 'This adds one global daily maintenance job at 05:00 local time to root'\''s crontab. Remove any older manual vss.maintenance entry first to avoid duplicate updates.\n'
        printf 'Type SCHEDULE to continue: '
        read -r confirmation
        if [ "$confirmation" = "SCHEDULE" ]; then
          set_maintenance_cron || notice="Could not schedule maintenance; review the error above."
        else
          notice="Maintenance schedule was not changed."
        fi
        ;;
      17)
        printf 'Type REMOVE to delete the global maintenance entry from root'\''s crontab: '
        read -r confirmation
        if [ "$confirmation" = "REMOVE" ]; then
          remove_maintenance_cron || notice="Could not remove the maintenance schedule; review the error above."
        else
          notice="Maintenance schedule was kept."
        fi
        ;;
      0) exit 0 ;;
      *) notice="Unknown option: $a" ;;
    esac
  done
}

function setup_usage() {
  cat <<'EOF'
Usage:
  ./setup [SERVER_NAME]
  ./setup --list
  ./setup --create SERVER_NAME
  ./setup --schedule-maintenance
  ./setup --remove-maintenance-schedule
  ./setup --maintenance-update
  ./setup --start-server SERVER_NAME
  ./setup --stop-server SERVER_NAME
  ./setup --restart-server SERVER_NAME
  ./setup --status-server SERVER_NAME
  ./setup --check-firewall SERVER_NAME
  ./setup --discord-update SERVER_NAME
  ./migrate-v2-to-v3
EOF
}

function run_discord_update() {
  printf 'Updating Discord for profile %s...\n' "$VSS_SERVER_NAME"
  if ! "$CWD/discord/update"; then
    printf 'Discord update failed for profile %s; see crash.log for details.\n' "$VSS_SERVER_NAME"
    return 1
  fi
  printf 'Discord update completed for profile %s.\n' "$VSS_SERVER_NAME"
}

function run_server_cli_action() {
  local action="$1"
  case "$action" in
    --start-server) start_valheim_service 2>&1 ;;
    --stop-server) stop_valheim_service 2>&1 ;;
    --restart-server) restart_valheim_service 2>&1 ;;
    --status-server) status_valheim_service 2>&1 ;;
    --check-firewall) check_ufw_profile_rules 2>&1 ;;
    --discord-update) run_discord_update 2>&1 ;;
    *) printf 'Unsupported direct action: %s\n' "$action"; return 2 ;;
  esac
}

function setup_main() {
  local selected_profile="${VSS_SERVER_NAME:-}"
  local profile
  local direct_action=""

  case "${1:-}" in
    --help|-h)
      setup_usage
      return 0
      ;;
    --list)
      list_server_profiles
      return 0
      ;;
    --maintenance-update)
      if [ -n "${2:-}" ]; then
        printf 'Option --maintenance-update does not accept a server name.\n'
        setup_usage
        return 2
      fi
      direct_action="$1"
      ;;
    --schedule-maintenance|--remove-maintenance-schedule)
      if [ -n "${2:-}" ]; then
        printf 'Option %s does not accept a server name.\n' "$1"
        setup_usage
        return 2
      fi
      direct_action="$1"
      ;;
    --start-server|--stop-server|--restart-server|--status-server|--check-firewall|--discord-update)
      if [ -z "${2:-}" ] || [ -n "${3:-}" ]; then
        printf 'Option %s requires exactly one server name.\n' "$1"
        setup_usage
        return 2
      fi
      direct_action="$1"
      ;;
  esac

  if [ -f "$CWD/.env" ] && ! grep -Fxq 'VSS_COMMON_CONFIG_VERSION=3' "$CWD/.env"; then
    printf 'A legacy .env was found. Run ./migrate-v2-to-v3 before using setup.\n' >&2
    return 1
  fi

  case "$direct_action" in
    --schedule-maintenance) set_maintenance_cron; return $? ;;
    --remove-maintenance-schedule) remove_maintenance_cron; return $? ;;
  esac

  if [ "$direct_action" = "--maintenance-update" ]; then
    if [ -z "$selected_profile" ]; then
      while IFS= read -r profile; do
        selected_profile="$profile"
        break
      done < <(list_server_profiles)
    fi
    if [ -z "$selected_profile" ] || ! load_server_profile "$selected_profile"; then
      printf 'No valid server profile is available for maintenance.\n' >&2
      return 1
    fi
    run_server_maintenance
    return $?
  fi

  if [ -n "$direct_action" ]; then
    if ! load_server_profile "$2"; then
      printf "Setup could not load profile '%s'. Review the error above and check its configuration.\n" "$2" >&2
      return 1
    fi
    run_server_cli_action "$direct_action"
    return $?
  fi

  case "${1:-}" in
    --create)
      if [ -z "${2:-}" ]; then
        return 1
      fi
      if ! create_server_profile "$2"; then
        return 1
      fi
      selected_profile="$2"
      ;;
    "")
      if [ -z "$selected_profile" ]; then
        select_server_profile || return 0
        selected_profile="$SELECTED_SERVER_PROFILE"
      fi
      ;;
    *)
      selected_profile="$1"
      ;;
  esac

  if ! load_server_profile "$selected_profile"; then
    printf "Setup could not load profile '%s'. Review the error above and check its configuration.\n" "$selected_profile" >&2
    return 1
  fi
  setup_ui_clear
  new_menu
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  setup_main "$@"
fi
